<Window x:Class="Frcistan.Pencereler.AnaPencere"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="clr-namespace:Frcistan.Altyapi"
        xmlns:k="clr-namespace:Frcistan.Kontroller"
        Style="{StaticResource Pencere}"
        Title="Frcistan" Width="1400" Height="880" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen" Icon="/Assets/ikon.png">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="kok">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= KENAR ÇUBUĞU ================= -->
        <Border Background="{DynamicResource Kenar.Arka}" BorderBrush="{DynamicResource Kenar.Cizgi}" BorderThickness="0,0,1,0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Ellipse Grid.RowSpan="3" Width="360" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-170,0,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#4A3D7EFF" Offset="0" />
                            <GradientStop Color="#003D7EFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <StackPanel Orientation="Horizontal" Margin="24,0,16,0" VerticalAlignment="Center">
                    <Image Source="/Assets/logo-beyaz.png" Height="27" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Frcistan" FontFamily="{StaticResource YaziBaslik}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Kenar.Metin}" />
                        <TextBlock Text="{Binding FirmaAdi}" FontSize="11.5" Foreground="{DynamicResource Kenar.Metin2}" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="14,10,14,10">
                        <TextBlock Text="MENÜ" Style="{StaticResource Yazi.Ust}" Foreground="{DynamicResource Kenar.Metin2}" Opacity="0.7" Margin="12,0,0,10" />
                        <ListBox Style="{StaticResource KenarMenusu}" ItemsSource="{Binding Menu}" SelectedItem="{Binding SeciliMenu}" />

                        <TextBlock Text="HIZLI İŞLEM" Style="{StaticResource Yazi.Ust}" Foreground="{DynamicResource Kenar.Metin2}" Opacity="0.7" Margin="12,24,0,10" />
                        <Button Style="{StaticResource Dugme.Birincil}" a:Ui.Ikon="&#xE7BF;" Content="Satış / stok çıkışı" HorizontalContentAlignment="Left"
                                Padding="14,0" MinHeight="40" Command="{Binding HizliSatisCommand}" ToolTip="Ctrl+S" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="14,0,14,14">
                    <!-- Lisans / deneme kartı -->
                    <Border Background="{DynamicResource Kenar.Kart}" CornerRadius="12" Padding="14,12" Margin="0,0,0,10"
                            Visibility="{Binding LisansKartiGorunur, Converter={StaticResource Gorunur}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IkonYazi}" FontSize="13" Foreground="#FBBF24" Margin="0,1,8,0" />
                                <TextBlock Text="{Binding Lisans.Baslik}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Kenar.Metin}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Lisans.Aciklama}" FontSize="11.5" Foreground="{DynamicResource Kenar.Metin2}" TextWrapping="Wrap" Margin="0,4,0,8" MaxHeight="46" TextTrimming="CharacterEllipsis" />
                            <Grid Height="4" Margin="0,0,0,10" x:Name="lisansCubugu">
                                <Border Background="#1AFFFFFF" CornerRadius="2" />
                                <Border Background="#FBBF24" CornerRadius="2" HorizontalAlignment="Left">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource OranGenislik}">
                                            <Binding Path="LisansOrani" />
                                            <Binding Path="ActualWidth" ElementName="lisansCubugu" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Grid>
                            <Button Style="{StaticResource Dugme.Baglanti}" Content="Lisans anahtarı gir →" FontSize="12" Foreground="#8DB4FF" Command="{Binding LisansCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Kullanıcı kartı -->
                    <Border Background="{DynamicResource Kenar.Kart}" CornerRadius="12" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3D7EFF" Offset="0" />
                                        <GradientStop Color="#8B5CF6" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="{Binding KullaniciAdi, Converter={StaticResource BasHarf}}" FontFamily="Segoe UI" Foreground="White" FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KullaniciAdi}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Kenar.Metin}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding RolMetni}" FontSize="11.5" Foreground="{DynamicResource Kenar.Metin2}" />
                            </StackPanel>
                            <Button x:Name="kullaniciMenuDugmesi" Grid.Column="2" Style="{StaticResource Dugme.Kenar}" a:Ui.Ikon="&#xE712;" Click="KullaniciMenusu_Click" ToolTip="Hesap">
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Top">
                                        <MenuItem Header="Şifre değiştir" a:Ui.Ikon="&#xE72E;" Command="{Binding SifreCommand}" />
                                        <MenuItem Header="Lisans" a:Ui.Ikon="&#xEA18;" Command="{Binding LisansCommand}" />
                                        <Separator />
                                        <MenuItem Header="Oturumu kapat" a:Ui.Ikon="&#xE8B5;" Command="{Binding CikisCommand}" Style="{StaticResource MenuOgesi.Tehlike}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Surum}" FontSize="11" Foreground="{DynamicResource Kenar.Metin2}" Opacity="0.6" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= İÇERİK ================= -->
        <Grid Grid.Column="1" Background="{DynamicResource Arka}">
            <Grid.RowDefinitions>
                <RowDefinition Height="84" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Üst çubuk -->
            <Grid Margin="34,0,0,0">
                <StackPanel VerticalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock Text="{Binding AktifSayfa.Baslik}" Style="{StaticResource Yazi.H1}" FontSize="24" />
                    <TextBlock Text="{Binding AktifSayfa.AltBaslik}" Style="{StaticResource Yazi.Kucuk}" FontSize="12.5" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,24,14,0" VerticalAlignment="Top">
                        <TextBox x:Name="genelArama" Style="{StaticResource Kutu.Arama}" Width="280" MinHeight="38" a:Ui.Ipucu="Ürün ara…   Ctrl+K"
                                 Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AraCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Grid Margin="10,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <ToggleButton x:Name="zilDugmesi" Style="{StaticResource Dugme}" IsHitTestVisible="{Binding IsOpen, ElementName=zilPopup, Converter={StaticResource TersBool}}" Width="38" Height="38" MinHeight="0" Padding="0" a:Ui.Ikon="&#xEA8F;" FontSize="15"
                                          Background="{DynamicResource Yuzey}" ToolTip="Kritik stok bildirimleri" />
                            <Border CornerRadius="9" Background="{DynamicResource Tehlike}" MinWidth="18" Height="18" Padding="5,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-5,-5,0" IsHitTestVisible="False" Visibility="{Binding KritikSayisi, Converter={StaticResource DoluGorunur}}">
                                <TextBlock Text="{Binding KritikSayisi}" Foreground="White" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Popup x:Name="zilPopup" IsOpen="{Binding IsChecked, ElementName=zilDugmesi}" StaysOpen="False" PlacementTarget="{Binding ElementName=zilDugmesi}"
                                   Placement="Bottom" HorizontalOffset="-330" VerticalOffset="6" AllowsTransparency="True" PopupAnimation="Fade"
                                   Closed="Zil_Closed">
                                <Border Padding="10,0,10,16">
                                    <Border Width="380" Background="{DynamicResource Kabarik}" BorderBrush="{DynamicResource Cizgi2}" BorderThickness="1" CornerRadius="14"
                                            Effect="{DynamicResource Golge.Orta}">
                                        <StackPanel>
                                            <Grid Margin="18,16,18,10">
                                                <StackPanel>
                                                    <TextBlock Text="Kritik stoklar" Style="{StaticResource Yazi.H3}" />
                                                    <TextBlock Style="{StaticResource Yazi.Kucuk}" Margin="0,2,0,0">
                                                        <Run Text="{Binding KritikSayisi, Mode=OneWay}" /><Run Text=" ürün kritik seviyede ya da tükendi" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding KritikUrunler}" Margin="8,0,8,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource Dugme.Hayalet}" HorizontalContentAlignment="Stretch" Padding="10,8" Margin="0,1" MinHeight="0"
                                                                    Command="{Binding DataContext.KritikUrunCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                    Click="ZilOgesi_Click" ToolTip="Stok girişi yap">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="{DynamicResource Uyari}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Durum}" Value="Tukendi">
                                                                                        <Setter Property="Background" Value="{DynamicResource Tehlike}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Text="{Binding UrunAdi}" Foreground="{DynamicResource Metin}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding Marka}" Style="{StaticResource Yazi.Kucuk}" FontWeight="Normal" />
                                                                    </StackPanel>
                                                                    <Border Grid.Column="2" Style="{StaticResource DurumRozeti}" Margin="10,0,0,0">
                                                                        <TextBlock Text="{Binding EksikMetni}" Style="{StaticResource Rozet.Yazi}" FontSize="11.5" />
                                                                    </Border>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <StackPanel Margin="24,20" Visibility="{Binding KritikSayisi, Converter={StaticResource DoluGorunur}, ConverterParameter=Ters}">
                                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IkonYazi}" FontSize="22" Foreground="{DynamicResource BasariMetin}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Tüm stoklar yeterli seviyede" Style="{StaticResource Yazi.Ikincil}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                            </StackPanel>
                                            <Border BorderBrush="{DynamicResource Cizgi}" BorderThickness="0,1,0,0" Padding="12">
                                                <Button Style="{StaticResource Dugme.Yumusak}" Content="Tümünü ürünler sayfasında gör" HorizontalAlignment="Stretch"
                                                        Command="{Binding KritikleriGorCommand}" Click="ZilOgesi_Click" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Popup>
                        </Grid>

                        <Button Margin="10,0,0,0" Width="38" Height="38" MinHeight="0" Padding="0" FontSize="15" Background="{DynamicResource Yuzey}"
                                Command="{Binding TemaDegistirCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Açık / koyu tema">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Dugme}">
                                    <Setter Property="a:Ui.Ikon" Value="&#xE706;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding KoyuTema}" Value="False">
                                            <Setter Property="a:Ui.Ikon" Value="&#xE708;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource Dugme.Pencere}" Content="&#xE921;" Click="Kucult_Click" ToolTip="Simge durumuna küçült" />
                        <Button x:Name="buyutDugmesi" Style="{StaticResource Dugme.Pencere}" Content="&#xE922;" Click="Buyut_Click" ToolTip="Ekranı kapla" />
                        <Button Style="{StaticResource Dugme.PencereKapat}" Content="&#xE8BB;" Click="Kapat_Click" ToolTip="Kapat" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Sayfa -->
            <ContentControl x:Name="sayfaKabi" Grid.Row="1" Content="{Binding AktifSayfa}" Margin="34,6,34,28" Focusable="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="sayfaKaydirma" />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <k:Katmanlar Grid.ColumnSpan="2" />
    </Grid>
</Window>
