<Window x:Class="Frcistan.Pencereler.KurulumPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="clr-namespace:Frcistan.Altyapi"
        xmlns:k="clr-namespace:Frcistan.Kontroller"
        Style="{StaticResource Pencere}"
        Title="Frcistan - Kurulum" Width="1000" Height="680"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="/Assets/ikon.png">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="AdimSayfasi" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sol: adımlar ===== -->
        <Grid ClipToBounds="True">
            <k:YildizliArkaPlan />
            <Grid Margin="36,38,30,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/logo-beyaz.png" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Frcistan" Foreground="White" FontFamily="{StaticResource YaziBaslik}" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="Kurulum sihirbazı" Foreground="#8590A3" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Adimlar}" Margin="0,54,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="22" />
                                </Grid.RowDefinitions>
                                <Border x:Name="daire" Width="32" Height="32" CornerRadius="16" BorderThickness="1.5" BorderBrush="#2E3747" Background="Transparent">
                                    <Grid>
                                        <TextBlock x:Name="no" Text="{Binding No}" Foreground="#8590A3" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="tik" Text="&#xE73E;" FontFamily="{StaticResource IkonYazi}" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <Border x:Name="cizgi" Grid.Row="1" Width="1.5" Background="#2E3747" HorizontalAlignment="Center" Margin="0,4,0,-4" />
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="baslik" Text="{Binding Baslik}" Foreground="#8590A3" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding Aciklama}" Foreground="#5B6577" FontSize="12" Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Durum}" Value="Aktif">
                                    <Setter TargetName="daire" Property="BorderBrush" Value="#3D7EFF" />
                                    <Setter TargetName="daire" Property="Background" Value="#263D7EFF" />
                                    <Setter TargetName="no" Property="Foreground" Value="White" />
                                    <Setter TargetName="baslik" Property="Foreground" Value="White" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Durum}" Value="Tamam">
                                    <Setter TargetName="daire" Property="BorderBrush" Value="#3D7EFF" />
                                    <Setter TargetName="daire" Property="Background" Value="#3D7EFF" />
                                    <Setter TargetName="no" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="tik" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="baslik" Property="Foreground" Value="#D5DBE6" />
                                    <Setter TargetName="cizgi" Property="Background" Value="#3D7EFF" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding No}" Value="5">
                                    <Setter TargetName="cizgi" Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2" Text="Kurulum birkaç dakika sürer. Tüm ayarları daha sonra değiştirebilirsiniz." Foreground="#6E788A" FontSize="12" TextWrapping="Wrap" />
            </Grid>
        </Grid>

        <!-- ===== Sağ: içerik ===== -->
        <Grid Grid.Column="1" Background="{DynamicResource Yuzey}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1">
                <Button Style="{StaticResource Dugme.Pencere}" Content="&#xE921;" Click="Kucult_Click" />
                <Button Style="{StaticResource Dugme.PencereKapat}" Content="&#xE8BB;" Click="Kapat_Click" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid Margin="56,64,56,24">
                    <!-- 0: Hoş geldiniz -->
                    <StackPanel Visibility="{Binding Adim, Converter={StaticResource EsitGorunur}, ConverterParameter=0}">
                        <TextBlock Text="Frcistan'a hoş geldiniz" Style="{StaticResource Yazi.H1}" FontSize="30" />
                        <TextBlock Style="{StaticResource Yazi.Ikincil}" FontSize="14.5" Margin="0,10,0,30" LineHeight="22"
                                   Text="FRC ve FTC robot parçası satan bayiler, okul ve takım atölyeleri için hazırlanmış stok yönetim programı. Birkaç adımda kurulumu tamamlayıp kullanmaya başlayabilirsiniz." />
                        <UniformGrid Columns="2">
                            <UniformGrid.Resources>
                                <Style TargetType="Border" BasedOn="{StaticResource Kart}">
                                    <Setter Property="Margin" Value="0,0,12,12" />
                                    <Setter Property="Padding" Value="18" />
                                    <Setter Property="Background" Value="{DynamicResource Yuzey2}" />
                                </Style>
                            </UniformGrid.Resources>
                            <Border>
                                <StackPanel>
                                    <Border Style="{StaticResource IkonKutusu}" HorizontalAlignment="Left"><TextBlock Text="&#xE7B8;" Style="{StaticResource Yazi.Ikon}" Foreground="{DynamicResource VurguMetin}" /></Border>
                                    <TextBlock Text="Stok takibi" Style="{StaticResource Yazi.H3}" Margin="0,14,0,4" />
                                    <TextBlock Text="Ürün kodu, raf konumu, kritik seviye; tükenen parçalar anında görünür." Style="{StaticResource Yazi.Ikincil}" />
                                </StackPanel>
                            </Border>
                            <Border>
                                <StackPanel>
                                    <Border Style="{StaticResource IkonKutusu}" HorizontalAlignment="Left" Background="{DynamicResource BasariYumusak}"><TextBlock Text="&#xE8AB;" Style="{StaticResource Yazi.Ikon}" Foreground="{DynamicResource BasariMetin}" /></Border>
                                    <TextBlock Text="Giriş, çıkış ve sayım" Style="{StaticResource Yazi.H3}" Margin="0,14,0,4" />
                                    <TextBlock Text="Her hareket kim, ne zaman, kaç adet bilgisiyle kayıt altında." Style="{StaticResource Yazi.Ikincil}" />
                                </StackPanel>
                            </Border>
                            <Border>
                                <StackPanel>
                                    <Border Style="{StaticResource IkonKutusu}" HorizontalAlignment="Left" Background="{DynamicResource UyariYumusak}"><TextBlock Text="&#xE9F9;" Style="{StaticResource Yazi.Ikon}" Foreground="{DynamicResource UyariMetin}" /></Border>
                                    <TextBlock Text="Raporlar" Style="{StaticResource Yazi.H3}" Margin="0,14,0,4" />
                                    <TextBlock Text="Excel'e aktarın, yazdırın ya da PDF olarak kaydedin." Style="{StaticResource Yazi.Ikincil}" />
                                </StackPanel>
                            </Border>
                            <Border>
                                <StackPanel>
                                    <Border Style="{StaticResource IkonKutusu}" HorizontalAlignment="Left" Background="{DynamicResource TehlikeYumusak}"><TextBlock Text="&#xE716;" Style="{StaticResource Yazi.Ikon}" Foreground="{DynamicResource TehlikeMetin}" /></Border>
                                    <TextBlock Text="Ekip çalışması" Style="{StaticResource Yazi.H3}" Margin="0,14,0,4" />
                                    <TextBlock Text="Yönetici ve personel rolleri; isterseniz ağdan çok bilgisayar." Style="{StaticResource Yazi.Ikincil}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                    <!-- 1: İşletme -->
                    <StackPanel Visibility="{Binding Adim, Converter={StaticResource EsitGorunur}, ConverterParameter=1}">
                        <TextBlock Text="İşletmenizi tanıyalım" Style="{StaticResource Yazi.H1}" />
                        <TextBlock Text="Bu bilgiler raporlarda ve ekranın üstünde görünür." Style="{StaticResource Yazi.Ikincil}" FontSize="14" Margin="0,8,0,30" />

                        <TextBlock Text="Firma adı" Style="{StaticResource Yazi.Etiket}" />
                        <TextBox Text="{Binding FirmaAdi, UpdateSourceTrigger=PropertyChanged}" a:Ui.Ikon="&#xE731;" a:Ui.Ipucu="ör. Robotistan Robotik" a:Ui.IlkOdak="True" MaxLength="80" />

                        <TextBlock Text="Para birimi" Style="{StaticResource Yazi.Etiket}" Margin="0,22,0,8" />
                        <Border Style="{StaticResource SecimGrubu}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Secim}" GroupName="para" Content="$  Amerikan doları" MinHeight="34" Padding="16,0"
                                             IsChecked="{Binding ParaBirimi, Converter={StaticResource EsitMi}, ConverterParameter=USD}" />
                                <RadioButton Style="{StaticResource Secim}" GroupName="para" Content="₺  Türk lirası" MinHeight="34" Padding="16,0"
                                             IsChecked="{Binding ParaBirimi, Converter={StaticResource EsitMi}, ConverterParameter=TRY}" />
                                <RadioButton Style="{StaticResource Secim}" GroupName="para" Content="€  Euro" MinHeight="34" Padding="16,0"
                                             IsChecked="{Binding ParaBirimi, Converter={StaticResource EsitMi}, ConverterParameter=EUR}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="FRC/FTC parçaları genelde dolar ile fiyatlanır." Style="{StaticResource Yazi.Kucuk}" Margin="0,8,0,0" />

                        <TextBlock Text="Varsayılan kritik stok seviyesi" Style="{StaticResource Yazi.Etiket}" Margin="0,22,0,7" />
                        <TextBox Text="{Binding MinStok, UpdateSourceTrigger=PropertyChanged}" a:Ui.Sayi="Tam" Width="160" HorizontalAlignment="Left" MaxLength="5" />
                        <TextBlock Text="Bir ürünün stoğu bu sayıya düşünce uyarı verilir. Her ürün için ayrıca değiştirilebilir." Style="{StaticResource Yazi.Kucuk}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 2: Veritabanı -->
                    <StackPanel Visibility="{Binding Adim, Converter={StaticResource EsitGorunur}, ConverterParameter=2}">
                    <StackPanel DataContext="{Binding Form}">
                        <TextBlock Text="Veriler nerede saklansın?" Style="{StaticResource Yazi.H1}" />
                        <TextBlock Text="Tek bilgisayarda kullanacaksanız ilk seçenek en kolayıdır." Style="{StaticResource Yazi.Ikincil}" FontSize="14" Margin="0,8,0,26" />

                        <RadioButton Style="{StaticResource SecenekKarti}" GroupName="vt" a:Ui.Ikon="&#xE7F4;"
                                     IsChecked="{Binding Tur, Converter={StaticResource EsitMi}, ConverterParameter=Sqlite}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Bu bilgisayar" Style="{StaticResource Yazi.H3}" />
                                    <Border Style="{StaticResource Rozet}" Background="{DynamicResource BasariYumusak}" Margin="10,0,0,0" Padding="8,1,8,2">
                                        <TextBlock Text="Önerilen" Style="{StaticResource Rozet.Yazi}" FontSize="11" Foreground="{DynamicResource BasariMetin}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Ek kurulum gerekmez. Veriler bu bilgisayarda saklanır ve her gün otomatik yedeklenir." Style="{StaticResource Yazi.Ikincil}" Margin="0,4,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SecenekKarti}" GroupName="vt" a:Ui.Ikon="&#xEE94;" Margin="0,12,0,0"
                                     IsChecked="{Binding Tur, Converter={StaticResource EsitMi}, ConverterParameter=MySql}">
                            <StackPanel>
                                <TextBlock Text="MySQL / MariaDB sunucusu" Style="{StaticResource Yazi.H3}" />
                                <TextBlock Text="Birden fazla bilgisayar aynı stoğu kullanır. XAMPP ya da ağdaki bir MySQL sunucusu gerekir." Style="{StaticResource Yazi.Ikincil}" Margin="0,4,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <Grid Margin="0,20,0,0" Visibility="{Binding MySql, Converter={StaticResource Gorunur}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Sunucu" Style="{StaticResource Yazi.Etiket}" />
                                <TextBox Text="{Binding Sunucu, UpdateSourceTrigger=PropertyChanged}" a:Ui.Ipucu="localhost" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Port" Style="{StaticResource Yazi.Etiket}" />
                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" a:Ui.Sayi="Tam" MaxLength="5" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                                <TextBlock Text="Veritabanı adı" Style="{StaticResource Yazi.Etiket}" />
                                <TextBox Text="{Binding Veritabani, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4">
                                <TextBlock Text="Kullanıcı" Style="{StaticResource Yazi.Etiket}" />
                                <TextBox Text="{Binding Kullanici, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <TextBlock Text="Şifre" Style="{StaticResource Yazi.Etiket}" />
                                <PasswordBox a:Ui.Sifre="{Binding Sifre}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding MySql, Converter={StaticResource Gorunur}}">
                            <Button a:Ui.Ikon="&#xE895;" Content="Bağlantıyı test et" Command="{Binding TestCommand}" />
                            <ContentControl Style="{StaticResource Donen}" Margin="14,0,0,0" Visibility="{Binding TestEdiliyor, Converter={StaticResource Gorunur}}" />
                        </StackPanel>
                        <Border CornerRadius="9" Padding="12,10" Margin="0,14,0,0" Visibility="{Binding TestSonucu, Converter={StaticResource DoluGorunur}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource TehlikeYumusak}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TehlikeMetin}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TestBasarili}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BasariYumusak}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource BasariMetin}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding TestSonucu}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    </StackPanel>

                    <!-- 3: Yönetici hesabı -->
                    <StackPanel Visibility="{Binding Adim, Converter={StaticResource EsitGorunur}, ConverterParameter=3}">
                        <TextBlock Text="Yönetici hesabınızı oluşturun" Style="{StaticResource Yazi.H1}" />
                        <TextBlock Text="Bu hesap ürünleri, kullanıcıları ve ayarları yönetebilir." Style="{StaticResource Yazi.Ikincil}" FontSize="14" Margin="0,8,0,28" />

                        <Border Style="{StaticResource Kart}" Background="{DynamicResource VurguYumusak}" BorderThickness="0"
                                Visibility="{Binding MevcutKurulum, Converter={StaticResource Gorunur}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IkonYazi}" FontSize="18" Foreground="{DynamicResource VurguMetin}" Margin="0,2,14,0" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock Text="Bu veritabanı zaten kurulu" Style="{StaticResource Yazi.H3}" />
                                    <TextBlock Text="Seçtiğiniz veritabanında kayıtlı kullanıcılar var. Kurulumu tamamladıktan sonra mevcut hesabınızla giriş yapabilirsiniz." Style="{StaticResource Yazi.Ikincil}" Margin="0,4,0,0" MaxWidth="460" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding MevcutKurulum, Converter={StaticResource Gorunur}, ConverterParameter=Ters}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Ad soyad" Style="{StaticResource Yazi.Etiket}" />
                                    <TextBox Text="{Binding AdSoyad, UpdateSourceTrigger=PropertyChanged}" a:Ui.Ipucu="ör. İlyas Enes Sepetci" MaxLength="100" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Kullanıcı adı" Style="{StaticResource Yazi.Etiket}" />
                                    <TextBox Text="{Binding KullaniciAdi, UpdateSourceTrigger=PropertyChanged}" a:Ui.Ikon="&#xE77B;" MaxLength="50" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Şifre" Style="{StaticResource Yazi.Etiket}" />
                                    <PasswordBox a:Ui.Sifre="{Binding Sifre}" a:Ui.Ikon="&#xE72E;" a:Ui.Ipucu="En az 6 karakter" />
                                    <k:SifreGucu Guc="{Binding SifreGucu}" Margin="0,8,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Şifre (tekrar)" Style="{StaticResource Yazi.Etiket}" />
                                    <PasswordBox a:Ui.Sifre="{Binding SifreTekrar}" a:Ui.Ikon="&#xE72E;" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource Kart}" Background="{DynamicResource Yuzey2}" Margin="0,24,0,0" Padding="16">
                                <CheckBox Style="{StaticResource Anahtar}" IsChecked="{Binding DemoVeri}">
                                    <StackPanel>
                                        <TextBlock Text="Örnek verilerle başla" Style="{StaticResource Yazi.H3}" FontSize="14" />
                                        <TextBlock Text="44 örnek FRC/FTC ürünü ve son 2 ayın stok hareketleri eklenir. Programı tanımak için idealdir; istediğiniz zaman silebilirsiniz." Style="{StaticResource Yazi.Ikincil}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- 4: Hazır -->
                    <StackPanel Visibility="{Binding Adim, Converter={StaticResource EsitGorunur}, ConverterParameter=4}" Margin="0,30,0,0">
                        <Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource BasariYumusak}" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Yazi.Ikon}" FontSize="32" Foreground="{DynamicResource BasariMetin}" />
                        </Border>
                        <TextBlock Text="Her şey hazır!" Style="{StaticResource Yazi.H1}" FontSize="32" Margin="0,24,0,8" />
                        <TextBlock Text="Frcistan kullanıma hazır. Giriş ekranında yönetici hesabınızla oturum açabilirsiniz." Style="{StaticResource Yazi.Ikincil}" FontSize="14.5" />
                        <Border Style="{StaticResource Kart}" Background="{DynamicResource Yuzey2}" Margin="0,28,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Firma" Style="{StaticResource Yazi.Kucuk}" Margin="0,0,0,10" />
                                <TextBlock Grid.Column="1" Text="{Binding FirmaAdi, TargetNullValue=—}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Text="Veritabanı" Style="{StaticResource Yazi.Kucuk}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OzetVeritabani}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Text="Yönetici" Style="{StaticResource Yazi.Kucuk}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding KullaniciAdi}" FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Alt çubuk -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource Cizgi}" BorderThickness="0,1,0,0" Padding="56,18">
                <Grid>
                    <TextBlock Text="{Binding Hata}" Foreground="{DynamicResource TehlikeMetin}" TextWrapping="Wrap" MaxWidth="330" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ContentControl Style="{StaticResource Donen}" Margin="0,0,16,0" Visibility="{Binding Mesgul, Converter={StaticResource Gorunur}}" />
                        <TextBlock Text="{Binding AdimMetni}" Style="{StaticResource Yazi.Kucuk}" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <Button Style="{StaticResource Dugme.Hayalet}" Content="Geri" Command="{Binding GeriCommand}" Margin="0,0,8,0" Padding="18,0" MinHeight="42" />
                        <Button Style="{StaticResource Dugme.Birincil}" Content="{Binding IleriMetni}" Command="{Binding IleriCommand}" MinHeight="42" Padding="22,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <k:Katmanlar Grid.ColumnSpan="2" />
    </Grid>
</Window>
