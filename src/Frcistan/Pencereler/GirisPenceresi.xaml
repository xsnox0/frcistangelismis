<Window x:Class="Frcistan.Pencereler.GirisPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="clr-namespace:Frcistan.Altyapi"
        xmlns:k="clr-namespace:Frcistan.Kontroller"
        Style="{StaticResource Pencere}"
        Title="Frcistan - Giriş" Width="1040" Height="660"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="/Assets/ikon.png">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Marka paneli ===== -->
        <Grid ClipToBounds="True">
            <k:YildizliArkaPlan />
            <Grid Margin="48,40,48,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/logo-beyaz.png" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Frcistan" Foreground="White" FontFamily="{StaticResource YaziBaslik}" FontSize="17" FontWeight="Bold" Margin="11,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Image Source="/Assets/logo-beyaz.png" Width="176" HorizontalAlignment="Left" Margin="0,0,0,36" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect Color="#8DB4FF" BlurRadius="36" ShadowDepth="0" Opacity="0.45" />
                        </Image.Effect>
                    </Image>
                    <TextBlock Text="FRC · FTC BAYİLERİ İÇİN" Foreground="#8DB4FF" FontSize="11.5" FontWeight="Bold" />
                    <TextBlock Text="Robot parçası stoğunuz, tek ekranda." Foreground="White" FontFamily="{StaticResource YaziBaslik}"
                               FontSize="31" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,14" LineHeight="38" />
                    <TextBlock Foreground="#A3ACBC" FontSize="14" TextWrapping="Wrap" LineHeight="21"
                               Text="Motorlar, motor sürücüler, swerve modülleri… Hangi parçadan kaç tane kaldığını, değerini ve hareketlerini saniyeler içinde görün." />
                    <StackPanel Margin="0,26,0,0">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#D5DBE6" />
                                <Setter Property="FontSize" Value="13.5" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </StackPanel.Resources>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#263D7EFF" Margin="0,0,12,0">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IkonYazi}" FontSize="10" Foreground="#8DB4FF" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Kritik stok uyarıları ve sipariş listesi" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#263D7EFF" Margin="0,0,12,0">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IkonYazi}" FontSize="10" Foreground="#8DB4FF" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Excel ve PDF raporlar, tek tıkla yedek" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#263D7EFF" Margin="0,0,12,0">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IkonYazi}" FontSize="10" Foreground="#8DB4FF" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Çok kullanıcılı, yetkiye göre erişim" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" Foreground="#6E788A" FontSize="11.5">
                    <Run Text="©" /> <Run Text="{Binding Yil, Mode=OneWay}" /> <Run Text="Frcistan ·" /> <Run Text="{Binding Surum, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Grid>

        <!-- ===== Form paneli ===== -->
        <Grid Grid.Column="1" Background="{DynamicResource Yuzey}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource Dugme.Pencere}" Content="&#xE921;" Click="Kucult_Click" ToolTip="Simge durumuna küçült" />
                <Button Style="{StaticResource Dugme.PencereKapat}" Content="&#xE8BB;" Click="Kapat_Click" ToolTip="Kapat" />
            </StackPanel>

            <Grid x:Name="form" Width="372" VerticalAlignment="Center">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="sallama" />
                </Grid.RenderTransform>

                <!-- Hazırlanıyor -->
                <StackPanel HorizontalAlignment="Center" Visibility="{Binding Durum, Converter={StaticResource EsitGorunur}, ConverterParameter=Hazirlaniyor}">
                    <ContentControl Style="{StaticResource Donen}" Width="34" Height="34" />
                    <TextBlock Text="Veritabanına bağlanılıyor…" Style="{StaticResource Yazi.Ikincil}" Margin="0,16,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Giriş -->
                <StackPanel Visibility="{Binding Durum, Converter={StaticResource EsitGorunur}, ConverterParameter=Giris}">
                    <Border Style="{StaticResource Rozet}" Background="{DynamicResource VurguYumusak}" Margin="0,0,0,18"
                            Visibility="{Binding FirmaAdi, Converter={StaticResource DoluGorunur}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE731;" FontFamily="{StaticResource IkonYazi}" FontSize="11" Foreground="{DynamicResource VurguMetin}" Margin="0,1,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FirmaAdi}" Style="{StaticResource Rozet.Yazi}" Foreground="{DynamicResource VurguMetin}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Hoş geldiniz" Style="{StaticResource Yazi.H1}" FontSize="30" />
                    <TextBlock Text="Devam etmek için hesabınıza giriş yapın." Style="{StaticResource Yazi.Ikincil}" FontSize="14" Margin="0,6,0,30" />

                    <TextBlock Text="Kullanıcı adı" Style="{StaticResource Yazi.Etiket}" />
                    <TextBox x:Name="kullaniciKutusu" Text="{Binding KullaniciAdi, UpdateSourceTrigger=PropertyChanged}" a:Ui.Ikon="&#xE77B;"
                             a:Ui.Ipucu="Kullanıcı adınız" MinHeight="44" MaxLength="50" />

                    <TextBlock Text="Şifre" Style="{StaticResource Yazi.Etiket}" Margin="0,18,0,7" />
                    <Grid>
                        <PasswordBox x:Name="sifreKutusu" a:Ui.Sifre="{Binding Sifre}" a:Ui.Ikon="&#xE72E;" a:Ui.Ipucu="Şifreniz" MinHeight="44" Padding="12,0,44,0"
                                     Visibility="{Binding SifreGoster, Converter={StaticResource Gorunur}, ConverterParameter=Ters}" />
                        <TextBox Text="{Binding Sifre, UpdateSourceTrigger=PropertyChanged}" a:Ui.Ikon="&#xE72E;" MinHeight="44" Padding="12,0,44,0"
                                 Visibility="{Binding SifreGoster, Converter={StaticResource Gorunur}}" />
                        <Button HorizontalAlignment="Right" Margin="0,0,5,0" Width="34" Height="34" IsTabStop="False"
                                Command="{Binding SifreGosterCommand}" ToolTip="Şifreyi göster / gizle">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Dugme.Ikon}">
                                    <Setter Property="a:Ui.Ikon" Value="&#xE7B3;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SifreGoster}" Value="True">
                                            <Setter Property="a:Ui.Ikon" Value="&#xED1A;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="capsUyari" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IkonYazi}" FontSize="12" Foreground="{DynamicResource UyariMetin}" Margin="0,1,7,0" />
                        <TextBlock Text="Caps Lock açık" FontSize="12" Foreground="{DynamicResource UyariMetin}" />
                    </StackPanel>

                    <CheckBox Content="Beni hatırla" IsChecked="{Binding BeniHatirla}" Margin="0,18,0,0" Foreground="{DynamicResource Metin2}" />

                    <Border Background="{DynamicResource TehlikeYumusak}" CornerRadius="9" Padding="12,10" Margin="0,18,0,0"
                            Visibility="{Binding Hata, Converter={StaticResource DoluGorunur}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE783;" FontFamily="{StaticResource IkonYazi}" FontSize="14" Foreground="{DynamicResource TehlikeMetin}" Margin="0,1,10,0" />
                            <TextBlock Text="{Binding Hata}" Foreground="{DynamicResource TehlikeMetin}" TextWrapping="Wrap" MaxWidth="300" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource Dugme.Birincil}" Margin="0,22,0,0" MinHeight="46" FontSize="14" Command="{Binding GirisCommand}">
                        <Grid>
                            <TextBlock Text="Giriş yap" Visibility="{Binding Mesgul, Converter={StaticResource Gorunur}, ConverterParameter=Ters}" />
                            <ContentControl Style="{StaticResource Donen}" Foreground="White" Visibility="{Binding Mesgul, Converter={StaticResource Gorunur}}" />
                        </Grid>
                    </Button>

                    <Border Style="{StaticResource Ayirac}" Margin="0,30,0,16" />
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xEE94;" FontFamily="{StaticResource IkonYazi}" FontSize="12" Foreground="{DynamicResource Metin3}" Margin="0,1,8,0" />
                            <TextBlock Text="{Binding VeritabaniAciklama}" Style="{StaticResource Yazi.Kucuk}" TextTrimming="CharacterEllipsis" MaxWidth="230" />
                        </StackPanel>
                        <Button Style="{StaticResource Dugme.Baglanti}" Content="Bağlantı ayarları" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding BaglantiAyarlariCommand}" />
                    </Grid>
                </StackPanel>

                <!-- Bağlantı hatası -->
                <StackPanel Visibility="{Binding Durum, Converter={StaticResource EsitGorunur}, ConverterParameter=Hata}">
                    <Border Style="{StaticResource IkonKutusu}" Width="56" Height="56" CornerRadius="16" Background="{DynamicResource TehlikeYumusak}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xEE94;" Style="{StaticResource Yazi.Ikon}" FontSize="24" Foreground="{DynamicResource TehlikeMetin}" />
                    </Border>
                    <TextBlock Text="Veritabanına bağlanılamadı" Style="{StaticResource Yazi.H1}" Margin="0,22,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BaglantiHatasi}" Style="{StaticResource Yazi.Ikincil}" FontSize="14" LineHeight="21" />
                    <Border Background="{DynamicResource Yuzey2}" CornerRadius="10" Padding="14,12" Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEE94;" FontFamily="{StaticResource IkonYazi}" FontSize="12" Foreground="{DynamicResource Metin3}" Margin="0,1,8,0" />
                            <TextBlock Text="{Binding VeritabaniAciklama}" Style="{StaticResource Yazi.Kucuk}" TextWrapping="Wrap" MaxWidth="300" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                        <Button Style="{StaticResource Dugme.Birincil}" a:Ui.Ikon="&#xE72C;" Content="Tekrar dene" Command="{Binding TekrarDeneCommand}" MinHeight="42" Padding="18,0" />
                        <Button a:Ui.Ikon="&#xE713;" Content="Bağlantı ayarları" Command="{Binding BaglantiAyarlariCommand}" MinHeight="42" Margin="10,0,0,0" Padding="18,0" />
                    </StackPanel>
                </StackPanel>

                <!-- İlk yönetici hesabı -->
                <StackPanel Visibility="{Binding Durum, Converter={StaticResource EsitGorunur}, ConverterParameter=IlkKullanici}">
                    <TextBlock Text="Yönetici hesabı oluşturun" Style="{StaticResource Yazi.H1}" />
                    <TextBlock Text="Bu veritabanında henüz kullanıcı yok. Tüm yetkilere sahip ilk hesabı oluşturun." Style="{StaticResource Yazi.Ikincil}" FontSize="14" Margin="0,6,0,24" />
                    <TextBlock Text="Ad soyad" Style="{StaticResource Yazi.Etiket}" />
                    <TextBox Text="{Binding YAdSoyad, UpdateSourceTrigger=PropertyChanged}" a:Ui.Ipucu="ör. İlyas Enes Sepetci" />
                    <TextBlock Text="Kullanıcı adı" Style="{StaticResource Yazi.Etiket}" Margin="0,14,0,7" />
                    <TextBox Text="{Binding YKullanici, UpdateSourceTrigger=PropertyChanged}" a:Ui.Ikon="&#xE77B;" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Şifre" Style="{StaticResource Yazi.Etiket}" />
                            <PasswordBox a:Ui.Sifre="{Binding YSifre}" a:Ui.Ipucu="En az 6 karakter" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Şifre (tekrar)" Style="{StaticResource Yazi.Etiket}" />
                            <PasswordBox a:Ui.Sifre="{Binding YSifreTekrar}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Hata}" Style="{StaticResource Yazi.Hata}" Margin="0,12,0,0" />
                    <Button Style="{StaticResource Dugme.Birincil}" Content="Hesabı oluştur ve giriş yap" Margin="0,20,0,0" MinHeight="46" FontSize="14"
                            Command="{Binding IlkKullaniciCommand}" />
                </StackPanel>
            </Grid>
        </Grid>

        <k:Katmanlar Grid.ColumnSpan="2" />
    </Grid>
</Window>
