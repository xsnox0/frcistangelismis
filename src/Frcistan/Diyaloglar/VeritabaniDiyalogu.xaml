<UserControl x:Class="Frcistan.Diyaloglar.VeritabaniDiyalogu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="clr-namespace:Frcistan.Altyapi"
             xmlns:k="clr-namespace:Frcistan.Kontroller">
    <k:DiyalogGovdesi Baslik="{Binding Baslik}" AltBaslik="Verilerin saklanacağı yeri seçin. Kaydettikten sonra program yeniden başlar." Ikon="&#xEE94;"
                      HataMetni="{Binding Hata}" Mesgul="{Binding Mesgul}">
        <k:DiyalogGovdesi.Alt>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Dugme.Hayalet}" Content="Vazgeç" Command="{Binding IptalCommand}" Margin="0,0,8,0" Padding="16,0" />
                <Button Style="{StaticResource Dugme.Birincil}" Content="Kaydet ve yeniden başlat" Command="{Binding KaydetCommand}" Padding="20,0" />
            </StackPanel>
        </k:DiyalogGovdesi.Alt>
        <StackPanel DataContext="{Binding Form}">
            <RadioButton Style="{StaticResource SecenekKarti}" GroupName="vtd" a:Ui.Ikon="&#xE7F4;"
                         IsChecked="{Binding Tur, Converter={StaticResource EsitMi}, ConverterParameter=Sqlite}">
                <StackPanel>
                    <TextBlock Text="Bu bilgisayar" Style="{StaticResource Yazi.H3}" FontSize="14" />
                    <TextBlock Text="Kurulum gerektirmez. Tek bilgisayarda kullanım için idealdir." Style="{StaticResource Yazi.Ikincil}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding SqliteYolu}" Style="{StaticResource Yazi.Kucuk}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource SecenekKarti}" GroupName="vtd" a:Ui.Ikon="&#xEE94;" Margin="0,10,0,0"
                         IsChecked="{Binding Tur, Converter={StaticResource EsitMi}, ConverterParameter=MySql}">
                <StackPanel>
                    <TextBlock Text="MySQL / MariaDB sunucusu" Style="{StaticResource Yazi.H3}" FontSize="14" />
                    <TextBlock Text="Ağdaki birden fazla bilgisayar aynı stoğu kullanır (XAMPP, sunucu, NAS)." Style="{StaticResource Yazi.Ikincil}" Margin="0,3,0,0" />
                </StackPanel>
            </RadioButton>

            <StackPanel Visibility="{Binding MySql, Converter={StaticResource Gorunur}}" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Sunucu" Style="{StaticResource Yazi.Etiket}" />
                        <TextBox Text="{Binding Sunucu, UpdateSourceTrigger=PropertyChanged}" a:Ui.Ipucu="localhost ya da 192.168.1.20" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Port" Style="{StaticResource Yazi.Etiket}" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" a:Ui.Sayi="Tam" MaxLength="5" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Veritabanı adı" Style="{StaticResource Yazi.Etiket}" Margin="0,14,0,7" />
                <TextBox Text="{Binding Veritabani, UpdateSourceTrigger=PropertyChanged}" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Kullanıcı" Style="{StaticResource Yazi.Etiket}" />
                        <TextBox Text="{Binding Kullanici, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Şifre" Style="{StaticResource Yazi.Etiket}" />
                        <PasswordBox a:Ui.Sifre="{Binding Sifre}" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button a:Ui.Ikon="&#xE895;" Content="Bağlantıyı test et" Command="{Binding TestCommand}" />
                    <ContentControl Style="{StaticResource Donen}" Margin="12,0,0,0" Visibility="{Binding TestEdiliyor, Converter={StaticResource Gorunur}}" />
                </StackPanel>
                <Border CornerRadius="9" Padding="12,9" Margin="0,12,0,0" Visibility="{Binding TestSonucu, Converter={StaticResource DoluGorunur}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource TehlikeYumusak}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource TehlikeMetin}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TestBasarili}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BasariYumusak}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource BasariMetin}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding TestSonucu}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Border Background="{DynamicResource Yuzey2}" CornerRadius="10" Padding="14,12" Margin="0,18,0,0"
                    Visibility="{Binding DataContext.OturumAcik, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Gorunur}}">
                <CheckBox IsChecked="{Binding DataContext.VerileriTasi, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <StackPanel>
                        <TextBlock Text="Mevcut verilerimi yeni veritabanına taşı" FontWeight="SemiBold" />
                        <TextBlock Text="Hedef veritabanı boşsa tüm ürünler, hareketler ve kullanıcılar oraya kopyalanır. Hedefte zaten veri varsa yalnızca bağlanılır."
                                   Style="{StaticResource Yazi.Kucuk}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </CheckBox>
            </Border>
        </StackPanel>
    </k:DiyalogGovdesi>
</UserControl>
