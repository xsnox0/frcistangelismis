<UserControl x:Class="Frcistan.Diyaloglar.UrunGecmisiDiyalogu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="clr-namespace:Frcistan.Altyapi"
             xmlns:k="clr-namespace:Frcistan.Kontroller">
    <k:DiyalogGovdesi Baslik="{Binding Baslik}" AltBaslik="{Binding AltBaslikMetni}" Ikon="&#xE81C;" HataMetni="{Binding Hata}">
        <k:DiyalogGovdesi.Alt>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Dugme.Hayalet}" Content="Kapat" Command="{Binding IptalCommand}" Margin="0,0,8,0" Padding="16,0" />
                <Button a:Ui.Ikon="&#xE738;" Content="Stok çıkışı" Command="{Binding CikisCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Dugme.Birincil}" a:Ui.Ikon="&#xE710;" Content="Stok girişi" Command="{Binding GirisCommand}" />
            </StackPanel>
        </k:DiyalogGovdesi.Alt>
        <StackPanel>
            <Grid DataContext="{Binding Satir}" Margin="0,0,-12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Yuzey2}" />
                        <Setter Property="CornerRadius" Value="10" />
                        <Setter Property="Padding" Value="14,10" />
                        <Setter Property="Margin" Value="0,0,12,0" />
                    </Style>
                </Grid.Resources>
                <Border>
                    <StackPanel>
                        <TextBlock Text="Stok" Style="{StaticResource Yazi.Kucuk}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"><Run Text="{Binding Adet, Mode=OneWay}" /><Run Text=" adet" FontSize="12.5" FontWeight="Normal" Foreground="{DynamicResource Metin3}" /></TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="Kritik seviye" Style="{StaticResource Yazi.Kucuk}" />
                        <TextBlock Text="{Binding MinStok}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="Stok değeri" Style="{StaticResource Yazi.Kucuk}" />
                        <TextBlock Text="{Binding StokDegeri, Converter={StaticResource Para}}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3">
                    <StackPanel>
                        <TextBlock Text="Raf" Style="{StaticResource Yazi.Kucuk}" />
                        <TextBlock Text="{Binding Konum}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,20,0,8">
                <TextBlock Text="Son 60 gün stok seviyesi" Style="{StaticResource Yazi.H3}" />
                <TextBlock HorizontalAlignment="Right" Style="{StaticResource Yazi.Kucuk}">
                    <Run Text="Toplam giriş" /> <Run Text="{Binding ToplamGiris, Mode=OneWay}" Foreground="{DynamicResource BasariMetin}" FontWeight="SemiBold" />
                    <Run Text="  ·  Toplam çıkış" /> <Run Text="{Binding ToplamCikis, Mode=OneWay}" Foreground="{DynamicResource TehlikeMetin}" FontWeight="SemiBold" />
                    <Run Text="  ·  Son hareket" /> <Run Text="{Binding SonHareket, Mode=OneWay}" Foreground="{DynamicResource Metin2}" />
                </TextBlock>
            </Grid>
            <k:AlanGrafik Height="170" Seriler="{Binding Seriler}" Etiketler="{Binding Etiketler}" />

            <TextBlock Text="Hareketler" Style="{StaticResource Yazi.H3}" Margin="0,20,0,8" />
            <Border BorderBrush="{DynamicResource Cizgi}" BorderThickness="1" CornerRadius="10" Height="250">
                <Grid>
                    <DataGrid Style="{StaticResource Tablo}" ItemsSource="{Binding Hareketler}" FontSize="13">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource TabloSatiri}">
                                <Setter Property="MinHeight" Value="44" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Tarih" SortMemberPath="Tarih" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center"><Run Text="{Binding TarihMetni, Mode=OneWay}" /> <Run Text="{Binding SaatMetni, Mode=OneWay}" Foreground="{DynamicResource Metin3}" /></TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Tür" Width="0.9*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TurRozeti}">
                                            <TextBlock Text="{Binding TurMetni}" Style="{StaticResource Rozet.Yazi}" FontSize="11.5" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Miktar" Binding="{Binding MiktarMetni}" Width="0.6*" HeaderStyle="{StaticResource Tablo.BaslikSag}" ElementStyle="{StaticResource Tablo.Sayi}" />
                            <DataGridTextColumn Header="Stok" Binding="{Binding StokGecisi}" Width="0.8*" HeaderStyle="{StaticResource Tablo.BaslikSag}" ElementStyle="{StaticResource Tablo.Sayi}" />
                            <DataGridTextColumn Header="Kullanıcı" Binding="{Binding KullaniciAdi}" Width="1*" />
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="1.6*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Metin2}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Bu ürün için henüz hareket yok" Style="{StaticResource Yazi.Ikincil}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Bos, Converter={StaticResource Gorunur}}" />
                </Grid>
            </Border>
        </StackPanel>
    </k:DiyalogGovdesi>
</UserControl>
