<UserControl x:Class="Frcistan.Diyaloglar.KategoriDiyalogu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="clr-namespace:Frcistan.Altyapi"
             xmlns:k="clr-namespace:Frcistan.Kontroller">
    <k:DiyalogGovdesi Baslik="{Binding Baslik}" Ikon="&#xE8EC;" HataMetni="{Binding Hata}" Mesgul="{Binding Mesgul}">
        <k:DiyalogGovdesi.Alt>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Dugme.Hayalet}" Content="Vazgeç" Command="{Binding IptalCommand}" Margin="0,0,8,0" Padding="16,0" />
                <Button Style="{StaticResource Dugme.Birincil}" a:Ui.Ikon="&#xE74E;" Content="Kaydet" Command="{Binding KaydetCommand}" Padding="20,0" IsDefault="True" />
            </StackPanel>
        </k:DiyalogGovdesi.Alt>
        <StackPanel>
            <!-- Önizleme -->
            <Border Background="{DynamicResource Yuzey2}" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="13" Background="{Binding Renk, Converter={StaticResource HexFirca}, ConverterParameter=Yumusak}">
                        <TextBlock Text="{Binding Ikon, Converter={StaticResource IkonKodu}}" Style="{StaticResource Yazi.Ikon}" FontSize="20" Foreground="{Binding Renk, Converter={StaticResource HexFirca}}" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Ad, TargetNullValue=Kategori adı, FallbackValue=Kategori adı}" Style="{StaticResource Yazi.H3}" />
                        <Border Style="{StaticResource Rozet}" Background="{DynamicResource Yuzey3}" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding Renk, Converter={StaticResource HexFirca}}" Margin="0,1,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Ad, TargetNullValue=Önizleme}" Style="{StaticResource Rozet.Yazi}" FontWeight="Normal" Foreground="{DynamicResource Metin2}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Kategori adı *" Style="{StaticResource Yazi.Etiket}" />
            <TextBox Text="{Binding Ad, UpdateSourceTrigger=PropertyChanged}" a:Ui.Ipucu="ör. Pnömatik" a:Ui.IlkOdak="True" MaxLength="60"
                     a:Ui.HataVar="{Binding AdHatasi, Converter={StaticResource DoluMu}}" />
            <TextBlock Text="{Binding AdHatasi}" Style="{StaticResource Yazi.Hata}" />

            <TextBlock Text="Renk" Style="{StaticResource Yazi.Etiket}" Margin="0,18,0,9" />
            <ItemsControl ItemsSource="{Binding Renkler}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="34" Height="34" Margin="0,0,8,8" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                Command="{Binding DataContext.RenkSecCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="halka" CornerRadius="17" BorderThickness="2" BorderBrush="Transparent" />
                                        <Border CornerRadius="13" Margin="4" Background="{Binding Converter={StaticResource HexFirca}}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="halka" Property="BorderBrush" Value="{DynamicResource Cizgi2}" />
                                        </Trigger>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{x:Static a:Esitlik.Ornek}">
                                                    <Binding />
                                                    <Binding Path="DataContext.Renk" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="halka" Property="BorderBrush" Value="{DynamicResource Metin}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="İkon" Style="{StaticResource Yazi.Etiket}" Margin="0,12,0,9" />
            <ItemsControl ItemsSource="{Binding Ikonlar}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="42" Height="42" Margin="0,0,8,8" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                Command="{Binding DataContext.IkonSecCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="kok" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource Cizgi}" Background="{DynamicResource Yuzey2}">
                                        <TextBlock x:Name="ikon" Text="{Binding Converter={StaticResource IkonKodu}}" Style="{StaticResource Yazi.Ikon}" FontSize="17" Foreground="{DynamicResource Metin2}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="kok" Property="BorderBrush" Value="{DynamicResource Cizgi2}" />
                                            <Setter TargetName="ikon" Property="Foreground" Value="{DynamicResource Metin}" />
                                        </Trigger>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{x:Static a:Esitlik.Ornek}">
                                                    <Binding />
                                                    <Binding Path="DataContext.Ikon" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="kok" Property="BorderBrush" Value="{DynamicResource Vurgu}" />
                                            <Setter TargetName="kok" Property="Background" Value="{DynamicResource VurguYumusak}" />
                                            <Setter TargetName="ikon" Property="Foreground" Value="{DynamicResource VurguMetin}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </k:DiyalogGovdesi>
</UserControl>
