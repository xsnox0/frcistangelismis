<UserControl x:Class="Frcistan.Diyaloglar.KullaniciDiyalogu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="clr-namespace:Frcistan.Altyapi"
             xmlns:k="clr-namespace:Frcistan.Kontroller">
    <k:DiyalogGovdesi Baslik="{Binding Baslik}" Ikon="&#xE77B;" HataMetni="{Binding Hata}" Mesgul="{Binding Mesgul}">
        <k:DiyalogGovdesi.Alt>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Dugme.Hayalet}" Content="Vazgeç" Command="{Binding IptalCommand}" Margin="0,0,8,0" Padding="16,0" />
                <Button Style="{StaticResource Dugme.Birincil}" a:Ui.Ikon="&#xE74E;" Content="Kaydet" Command="{Binding KaydetCommand}" Padding="20,0" IsDefault="True" />
            </StackPanel>
        </k:DiyalogGovdesi.Alt>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Ad soyad" Style="{StaticResource Yazi.Etiket}" />
                    <TextBox Text="{Binding AdSoyad, UpdateSourceTrigger=PropertyChanged}" a:Ui.Ipucu="ör. Ayşe Yılmaz" a:Ui.IlkOdak="True" MaxLength="100" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Kullanıcı adı *" Style="{StaticResource Yazi.Etiket}" />
                    <TextBox Text="{Binding KullaniciAdi, UpdateSourceTrigger=PropertyChanged}" a:Ui.Ikon="&#xE77B;" a:Ui.Ipucu="ör. ayse" MaxLength="50" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Rol" Style="{StaticResource Yazi.Etiket}" Margin="0,18,0,9" />
            <UniformGrid Columns="2" IsEnabled="{Binding Ben, Converter={StaticResource TersBool}}">
                <RadioButton Style="{StaticResource SecenekKarti}" GroupName="rol" a:Ui.Ikon="&#xE7EF;" Margin="0,0,7,0"
                             IsChecked="{Binding Rol, Converter={StaticResource EsitMi}, ConverterParameter=Admin}">
                    <StackPanel>
                        <TextBlock Text="Yönetici" Style="{StaticResource Yazi.H3}" FontSize="14" />
                        <TextBlock Text="Her şeyi yönetir" Style="{StaticResource Yazi.Kucuk}" Margin="0,2,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SecenekKarti}" GroupName="rol" a:Ui.Ikon="&#xE716;" Margin="7,0,0,0"
                             IsChecked="{Binding Rol, Converter={StaticResource EsitMi}, ConverterParameter=Personel}">
                    <StackPanel>
                        <TextBlock Text="Personel" Style="{StaticResource Yazi.H3}" FontSize="14" />
                        <TextBlock Text="Stok giriş / çıkışı yapar" Style="{StaticResource Yazi.Kucuk}" Margin="0,2,0,0" />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <TextBlock Text="{Binding SifreBasligi}" Style="{StaticResource Yazi.H3}" FontSize="14" Margin="0,22,0,12" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Şifre" Style="{StaticResource Yazi.Etiket}" />
                    <PasswordBox a:Ui.Sifre="{Binding Sifre}" a:Ui.Ikon="&#xE72E;" a:Ui.Ipucu="En az 6 karakter" />
                    <k:SifreGucu Guc="{Binding SifreGucu}" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Şifre (tekrar)" Style="{StaticResource Yazi.Etiket}" />
                    <PasswordBox a:Ui.Sifre="{Binding SifreTekrar}" a:Ui.Ikon="&#xE72E;" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Şifreyi değiştirmek istemiyorsanız boş bırakın." Style="{StaticResource Yazi.Kucuk}" Margin="0,8,0,0"
                       Visibility="{Binding YeniMi, Converter={StaticResource Gorunur}, ConverterParameter=Ters}" />

            <Border Style="{StaticResource Ayirac}" Margin="0,20,0,14" />
            <CheckBox Style="{StaticResource Anahtar}" IsChecked="{Binding Aktif}" IsEnabled="{Binding Ben, Converter={StaticResource TersBool}}">
                <StackPanel>
                    <TextBlock Text="Hesap aktif" Style="{StaticResource Yazi.H3}" FontSize="14" />
                    <TextBlock Text="Devre dışı bırakılan kullanıcı giriş yapamaz; geçmiş kayıtları korunur." Style="{StaticResource Yazi.Kucuk}" Margin="0,2,0,0" />
                </StackPanel>
            </CheckBox>
        </StackPanel>
    </k:DiyalogGovdesi>
</UserControl>
