<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:a="clr-namespace:Frcistan.Altyapi">

    <!-- ===== Yazı tipleri ===== -->
    <FontFamily x:Key="Yazi">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="YaziBaslik">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IkonYazi">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== Dönüştürücüler ===== -->
    <a:GorunurConverter x:Key="Gorunur" />
    <a:DoluGorunurConverter x:Key="DoluGorunur" />
    <a:DoluMuConverter x:Key="DoluMu" />
    <a:TersBoolConverter x:Key="TersBool" />
    <a:EsitMiConverter x:Key="EsitMi" />
    <a:EsitGorunurConverter x:Key="EsitGorunur" />
    <a:ParaConverter x:Key="Para" />
    <a:SayiConverter x:Key="Sayi" />
    <a:HexFircaConverter x:Key="HexFirca" />
    <a:IkonKoduConverter x:Key="IkonKodu" />
    <a:BasHarfConverter x:Key="BasHarf" />
    <a:GoreceliTarihConverter x:Key="GoreceliTarih" />
    <a:OranGenislikConverter x:Key="OranGenislik" />
    <a:SutunSayisiConverter x:Key="SutunSayisi" />

    <!-- ===== Pencere ===== -->
    <Style x:Key="Pencere" TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource Yazi}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
        <Setter Property="Background" Value="{DynamicResource Arka}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- ===== Yazı stilleri ===== -->
    <Style x:Key="Yazi.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource YaziBaslik}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
    </Style>
    <Style x:Key="Yazi.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource YaziBaslik}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
    </Style>
    <Style x:Key="Yazi.H3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
    </Style>
    <Style x:Key="Yazi.Govde" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
    </Style>
    <Style x:Key="Yazi.Ikincil" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Metin2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Yazi.Kucuk" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Metin3}" />
    </Style>
    <Style x:Key="Yazi.Etiket" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Metin2}" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <Style x:Key="Yazi.Ust" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Metin3}" />
    </Style>
    <Style x:Key="Yazi.Hata" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TehlikeMetin}" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Visibility" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource DoluGorunur}}" />
    </Style>
    <Style x:Key="Yazi.Ikon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IkonYazi}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Yazi.KPI" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource YaziBaslik}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
    </Style>

    <!-- ===== Kart ===== -->
    <Style x:Key="Kart" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Yuzey}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cizgi}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Ayirac" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Cizgi}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===== Rozet (etiket hapı) ===== -->
    <Style x:Key="Rozet" TargetType="Border">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="9,3,10,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Yuzey3}" />
    </Style>
    <Style x:Key="Rozet.Yazi" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== İkon kutusu (renkli kare içinde ikon) ===== -->
    <Style x:Key="IkonKutusu" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{DynamicResource VurguYumusak}" />
    </Style>

    <!-- ===== Dönen yükleniyor göstergesi ===== -->
    <Style x:Key="Donen" TargetType="ContentControl">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource Vurgu}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox>
                        <Grid Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Grid.RenderTransform>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:0.8" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                            <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="2.5" Opacity="0.2" Margin="1.25" />
                            <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 10,1.25 A 8.75,8.75 0 0 1 18.75,10" />
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Odak çerçevesi kullanılmaz; odak durumları şablonlarda gösterilir -->
    <Style x:Key="OdakYok">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
