<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:a="clr-namespace:Frcistan.Altyapi">

    <!-- ===================================================================
         DÜĞMELER
         =================================================================== -->
    <ControlTemplate x:Key="DugmeSablonu" TargetType="ButtonBase">
        <Border x:Name="kok" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"
                CornerRadius="{Binding (a:Ui.Kose), RelativeSource={RelativeSource TemplatedParent}}">
            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <TextBlock x:Name="ikon" Text="{Binding (a:Ui.Ikon), RelativeSource={RelativeSource TemplatedParent}}"
                           FontFamily="{StaticResource IkonYazi}" FontSize="{TemplateBinding FontSize}" FontWeight="Normal"
                           VerticalAlignment="Center" Margin="0,1,8,0" Foreground="{TemplateBinding Foreground}" />
                <ContentPresenter x:Name="icerik" VerticalAlignment="Center" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="a:Ui.Ikon" Value="{x:Null}">
                <Setter TargetName="ikon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="ikon" Property="Margin" Value="0" />
                <Setter TargetName="icerik" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="kok" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- İkincil düğme (varsayılan) -->
    <Style x:Key="Dugme" TargetType="ButtonBase">
        <Setter Property="Template" Value="{StaticResource DugmeSablonu}" />
        <Setter Property="Background" Value="{DynamicResource Yuzey2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cizgi}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource OdakYok}" />
        <Setter Property="a:Ui.Kose" Value="9" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Yuzey3}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Cizgi2}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cizgi}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Vurgu}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Dugme}" />

    <Style x:Key="Dugme.Birincil" TargetType="ButtonBase" BasedOn="{StaticResource Dugme}">
        <Setter Property="Background" Value="{DynamicResource Vurgu}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vurgu}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource VurguHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource VurguHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource VurguBasili}" />
                <Setter Property="BorderBrush" Value="{DynamicResource VurguBasili}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource VurguMetin}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dugme.Tehlike" TargetType="ButtonBase" BasedOn="{StaticResource Dugme}">
        <Setter Property="Background" Value="{DynamicResource Tehlike}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tehlike}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TehlikeHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TehlikeHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dugme.Hayalet" TargetType="ButtonBase" BasedOn="{StaticResource Dugme}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Metin2}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Yuzey3}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Metin}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cizgi}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dugme.TehlikeHayalet" TargetType="ButtonBase" BasedOn="{StaticResource Dugme.Hayalet}">
        <Setter Property="Foreground" Value="{DynamicResource TehlikeMetin}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TehlikeYumusak}" />
                <Setter Property="Foreground" Value="{DynamicResource TehlikeMetin}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dugme.Yumusak" TargetType="ButtonBase" BasedOn="{StaticResource Dugme}">
        <Setter Property="Background" Value="{DynamicResource VurguYumusak}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VurguMetin}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Vurgu}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Kare ikon düğmesi -->
    <Style x:Key="Dugme.Ikon" TargetType="ButtonBase" BasedOn="{StaticResource Dugme.Hayalet}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="a:Ui.Kose" Value="8" />
    </Style>
    <Style x:Key="Dugme.IkonTehlike" TargetType="ButtonBase" BasedOn="{StaticResource Dugme.Ikon}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TehlikeYumusak}" />
                <Setter Property="Foreground" Value="{DynamicResource TehlikeMetin}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bağlantı görünümlü düğme -->
    <Style x:Key="Dugme.Baglanti" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource VurguMetin}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource OdakYok}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <ContentPresenter x:Name="icerik" TextElement.Foreground="{TemplateBinding Foreground}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="icerik" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pencere başlık düğmeleri -->
    <Style x:Key="Dugme.Pencere" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{DynamicResource Metin2}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource IkonYazi}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource OdakYok}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Yuzey3}" />
                <Setter Property="Foreground" Value="{DynamicResource Metin}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Dugme.PencereKapat" TargetType="Button" BasedOn="{StaticResource Dugme.Pencere}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E81123" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================
         SEÇİM GRUBU (segmented) ve FİLTRE HAPI
         =================================================================== -->
    <Style x:Key="SecimGrubu" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Yuzey2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cizgi}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="Secim" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Metin2}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource OdakYok}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="kok" Background="{TemplateBinding Background}" CornerRadius="7" MinHeight="{TemplateBinding MinHeight}">
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="ikon" Text="{Binding (a:Ui.Ikon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource IkonYazi}" FontSize="12" Margin="0,1,7,0" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="a:Ui.Ikon" Value="{x:Null}">
                            <Setter TargetName="ikon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Metin}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="kok" Property="Background" Value="{DynamicResource Yuzey}" />
                            <Setter TargetName="kok" Property="Effect" Value="{DynamicResource Golge.Orta}" />
                            <Setter Property="Foreground" Value="{DynamicResource Metin}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Büyük seçenek kartı (kurulum sihirbazında veritabanı seçimi gibi) -->
    <Style x:Key="SecenekKarti" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource OdakYok}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="kok" Background="{DynamicResource Yuzey2}" BorderBrush="{DynamicResource Cizgi}" BorderThickness="1.5"
                            CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ikonKutu" Width="42" Height="42" CornerRadius="11" Background="{DynamicResource Yuzey3}" Margin="0,0,14,0" VerticalAlignment="Top">
                                <TextBlock x:Name="ikon" Text="{Binding (a:Ui.Ikon), RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource Yazi.Ikon}"
                                           FontSize="18" Foreground="{DynamicResource Metin2}" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            <Border x:Name="nokta" Grid.Column="2" Width="20" Height="20" CornerRadius="10" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource Cizgi2}" VerticalAlignment="Top" Margin="12,0,0,0">
                                <Ellipse x:Name="ic" Width="10" Height="10" Fill="White" Visibility="Collapsed" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="kok" Property="BorderBrush" Value="{DynamicResource Cizgi2}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="kok" Property="BorderBrush" Value="{DynamicResource Vurgu}" />
                            <Setter TargetName="kok" Property="Background" Value="{DynamicResource VurguYumusak}" />
                            <Setter TargetName="ikonKutu" Property="Background" Value="{DynamicResource Vurgu}" />
                            <Setter TargetName="ikon" Property="Foreground" Value="White" />
                            <Setter TargetName="nokta" Property="Background" Value="{DynamicResource Vurgu}" />
                            <Setter TargetName="nokta" Property="BorderBrush" Value="{DynamicResource Vurgu}" />
                            <Setter TargetName="ic" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         METİN KUTUSU
         =================================================================== -->
    <Style x:Key="Kutu" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Yuzey2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cizgi}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Metin}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Vurgu}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource OdakYok}" />
        <Setter Property="ContextMenu" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="kok" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ikon" Text="{Binding (a:Ui.Ikon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource IkonYazi}" FontSize="14" Foreground="{DynamicResource Metin3}"
                                       Margin="13,0,-3,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ipucu" Grid.Column="1" Text="{Binding (a:Ui.Ipucu), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource Metin3}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False"
                                       Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="a:Ui.Ikon" Value="{x:Null}">
                            <Setter TargetName="ikon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ipucu" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="kok" Property="BorderBrush" Value="{DynamicResource Cizgi2}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="kok" Property="BorderBrush" Value="{DynamicResource Vurgu}" />
                            <Setter TargetName="kok" Property="Background" Value="{DynamicResource Yuzey}" />
                        </Trigger>
                        <Trigger Property="a:Ui.HataVar" Value="True">
                            <Setter TargetName="kok" Property="BorderBrush" Value="{DynamicResource Tehlike}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="kok" Property="Background" Value="{DynamicResource Yuzey3}" />
                            <Setter Property="Foreground" Value="{DynamicResource Metin2}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="kok" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Kutu}" />

    <Style x:Key="Kutu.CokSatir" TargetType="TextBox" BasedOn="{StaticResource Kutu}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinHeight" Value="76" />
    </Style>

    <!-- Büyük arama kutusu -->
    <Style x:Key="Kutu.Arama" TargetType="TextBox" BasedOn="{StaticResource Kutu}">
        <Setter Property="a:Ui.Ikon" Value="&#xE721;" />
        <Setter Property="Background" Value="{DynamicResource Yuzey}" />
    </Style>

    <!-- ===================================================================
         ŞİFRE KUTUSU
         =================================================================== -->
    <Style x:Key="SifreKutusu" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource Yuzey2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cizgi}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Metin}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Vurgu}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource OdakYok}" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="kok" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ikon" Text="{Binding (a:Ui.Ikon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource IkonYazi}" FontSize="14" Foreground="{DynamicResource Metin3}"
                                       Margin="13,0,-3,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ipucu" Grid.Column="1" Text="{Binding (a:Ui.Ipucu), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource Metin3}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="False"
                                          VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="a:Ui.Ikon" Value="{x:Null}">
                            <Setter TargetName="ikon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="a:Ui.Dolu" Value="True">
                            <Setter TargetName="ipucu" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="kok" Property="BorderBrush" Value="{DynamicResource Cizgi2}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="kok" Property="BorderBrush" Value="{DynamicResource Vurgu}" />
                            <Setter TargetName="kok" Property="Background" Value="{DynamicResource Yuzey}" />
                        </Trigger>
                        <Trigger Property="a:Ui.HataVar" Value="True">
                            <Setter TargetName="kok" Property="BorderBrush" Value="{DynamicResource Tehlike}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource SifreKutusu}" />

    <!-- ===================================================================
         AÇILIR LİSTE (ComboBox)
         =================================================================== -->
    <ControlTemplate x:Key="SeciciOkSablonu" TargetType="ToggleButton">
        <Border Background="Transparent">
            <TextBlock x:Name="ok" Text="&#xE70D;" FontFamily="{StaticResource IkonYazi}" FontSize="10"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,13,0"
                       Foreground="{DynamicResource Metin3}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ok" Property="Foreground" Value="{DynamicResource Metin}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="SeciciIcKutu" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Metin}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Vurgu}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SeciciOgesi" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource OdakYok}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="kok" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="kok" Property="Background" Value="{DynamicResource Yuzey3}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="kok" Property="Background" Value="{DynamicResource VurguYumusak}" />
                            <Setter Property="Foreground" Value="{DynamicResource VurguMetin}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Secici" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Yuzey2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cizgi}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="13,0,34,0" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SeciciOgesi}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource OdakYok}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="kok" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" SnapsToDevicePixels="True" />
                        <ToggleButton x:Name="dugme" Template="{StaticResource SeciciOkSablonu}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="secili" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <TextBlock x:Name="ipucu" Text="{Binding (a:Ui.Ipucu), RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{DynamicResource Metin3}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Visibility="Collapsed" />
                        <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource SeciciIcKutu}" Visibility="Collapsed"
                                 Margin="11,0,32,0" VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}"
                                 IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               VerticalOffset="2" HorizontalOffset="-8"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Padding="8,4,8,14">
                                <Border x:Name="acilir" MinWidth="{Binding ActualWidth, ElementName=kok}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource Kabarik}" BorderBrush="{DynamicResource Cizgi2}" BorderThickness="1"
                                        CornerRadius="10" Padding="4" Effect="{DynamicResource Golge.Orta}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="secili" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="dugme" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="dugme" Property="Width" Value="34" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="False" />
                                <Condition Property="SelectedIndex" Value="-1" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ipucu" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="True" />
                                <Condition Property="Text" Value="" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ipucu" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="kok" Property="BorderBrush" Value="{DynamicResource Cizgi2}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="kok" Property="BorderBrush" Value="{DynamicResource Vurgu}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="kok" Property="BorderBrush" Value="{DynamicResource Vurgu}" />
                        </Trigger>
                        <Trigger Property="a:Ui.HataVar" Value="True">
                            <Setter TargetName="kok" Property="BorderBrush" Value="{DynamicResource Tehlike}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="acilir" Property="MinHeight" Value="38" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="kok" Property="Opacity" Value="0.55" />
                            <Setter TargetName="secili" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Secici}" />

    <!-- ===================================================================
         ONAY KUTUSU ve ANAHTAR
         =================================================================== -->
    <Style x:Key="Onay" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource OdakYok}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="kutu" Width="19" Height="19" CornerRadius="5.5" BorderThickness="1.5"
                                BorderBrush="{DynamicResource Cizgi2}" Background="{DynamicResource Yuzey2}" VerticalAlignment="Center">
                            <TextBlock x:Name="tik" Text="&#xE73E;" FontFamily="{StaticResource IkonYazi}" FontSize="11" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="kutu" Property="BorderBrush" Value="{DynamicResource Vurgu}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="kutu" Property="Background" Value="{DynamicResource Vurgu}" />
                            <Setter TargetName="kutu" Property="BorderBrush" Value="{DynamicResource Vurgu}" />
                            <Setter TargetName="tik" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource Onay}" />

    <Style x:Key="Anahtar" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource OdakYok}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Margin="0,0,14,0" VerticalAlignment="Center" />
                        <Border x:Name="ray" Grid.Column="1" Width="42" Height="24" CornerRadius="12" Background="{DynamicResource Cizgi2}" VerticalAlignment="Center">
                            <Ellipse x:Name="top" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="kay" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ray" Property="Background" Value="{DynamicResource Vurgu}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="kay" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="kay" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         KAYDIRMA ÇUBUĞU
         =================================================================== -->
    <Style x:Key="KaydirmaSayfa" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KaydirmaTutamak" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="tut" CornerRadius="4" Background="{DynamicResource Kaydirma}" Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tut" Property="Background" Value="{DynamicResource KaydirmaHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="tut" Property="Background" Value="{DynamicResource KaydirmaHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="11" />
        <Setter Property="MinWidth" Value="11" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource KaydirmaSayfa}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource KaydirmaTutamak}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource KaydirmaSayfa}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="11" />
                <Setter Property="MinHeight" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource KaydirmaSayfa}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource KaydirmaTutamak}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource KaydirmaSayfa}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================
         İPUCU BALONU, SAĞ TIK MENÜSÜ
         =================================================================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Padding="6,4,6,12">
                        <Border Background="{DynamicResource Kabarik}" BorderBrush="{DynamicResource Cizgi2}" BorderThickness="1"
                                CornerRadius="8" Padding="10,6" MaxWidth="320" Effect="{DynamicResource Golge.Orta}">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
        <Setter Property="FontFamily" Value="{StaticResource Yazi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Padding="8,4,8,14">
                        <Border Background="{DynamicResource Kabarik}" BorderBrush="{DynamicResource Cizgi2}" BorderThickness="1"
                                CornerRadius="10" Padding="4" MinWidth="200" Effect="{DynamicResource Golge.Orta}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Metin}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="kok" Background="Transparent" CornerRadius="7" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ikon" Text="{Binding (a:Ui.Ikon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource IkonYazi}" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Metin2}" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource Metin3}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="kok" Property="Background" Value="{DynamicResource Yuzey3}" />
                            <Setter TargetName="ikon" Property="Foreground" Value="{DynamicResource Metin}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MenuOgesi.Tehlike" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Foreground" Value="{DynamicResource TehlikeMetin}" />
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource Cizgi}" Margin="6,4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         LİSTE (genel, seçim göstermeyen)
         =================================================================== -->
    <Style x:Key="DuzListe" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Seçilebilir satır listesi (ürün seçici vb.) -->
    <Style x:Key="SecimListesi" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Foreground" Value="{DynamicResource Metin}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="kok" Background="Transparent" CornerRadius="9" Padding="10,8" Margin="0,1"
                                        BorderThickness="1" BorderBrush="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="kok" Property="Background" Value="{DynamicResource Yuzey3}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="kok" Property="Background" Value="{DynamicResource VurguYumusak}" />
                                        <Setter TargetName="kok" Property="BorderBrush" Value="{DynamicResource Vurgu}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
