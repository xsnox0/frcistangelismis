<Application x:Class="Frcistan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="clr-namespace:Frcistan.Altyapi"
             xmlns:k="clr-namespace:Frcistan.Kontroller"
             xmlns:vm="clr-namespace:Frcistan.ViewModels"
             xmlns:s="clr-namespace:Frcistan.Sayfalar"
             xmlns:d="clr-namespace:Frcistan.Diyaloglar"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Temalar/Renkler.Koyu.xaml" />
                <ResourceDictionary Source="Temalar/Temel.xaml" />
                <ResourceDictionary Source="Temalar/Kontroller.xaml" />
                <ResourceDictionary Source="Temalar/Tablo.xaml" />
                <ResourceDictionary Source="Temalar/Ozel.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <a:KaynakFircaConverter x:Key="KaynakFirca" />

            <!-- Görünüm modeli → görünüm eşleştirmeleri -->
            <DataTemplate DataType="{x:Type vm:PanelViewModel}"><s:PanelSayfasi /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:UrunlerViewModel}"><s:UrunlerSayfasi /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:HareketlerViewModel}"><s:HareketlerSayfasi /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:KategorilerViewModel}"><s:KategorilerSayfasi /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RaporlarViewModel}"><s:RaporlarSayfasi /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:KullanicilarViewModel}"><s:KullanicilarSayfasi /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AyarlarViewModel}"><s:AyarlarSayfasi /></DataTemplate>

            <DataTemplate DataType="{x:Type a:MesajViewModel}"><d:MesajDiyalogu /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:UrunDiyalogViewModel}"><d:UrunDiyalogu /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StokDiyalogViewModel}"><d:StokDiyalogu /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:KategoriDiyalogViewModel}"><d:KategoriDiyalogu /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:KullaniciDiyalogViewModel}"><d:KullaniciDiyalogu /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SifreDiyalogViewModel}"><d:SifreDiyalogu /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:VeritabaniDiyalogViewModel}"><d:VeritabaniDiyalogu /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AktarimDiyalogViewModel}"><d:AktarimDiyalogu /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LisansDiyalogViewModel}"><d:LisansDiyalogu /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SecimDiyalogViewModel}"><d:SecimDiyalogu /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:UrunGecmisiViewModel}"><d:UrunGecmisiDiyalogu /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
