<UserControl x:Class="Frcistan.Kontroller.Katmanlar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="clr-namespace:Frcistan.Altyapi">
    <!-- Her pencerenin en üstünde durur: açık diyaloglar ve sağ alttaki bildirimler -->
    <Grid>
        <ItemsControl ItemsSource="{x:Static a:Diyalog.Acik}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Border x:Name="perde" Background="{DynamicResource Perde}" Opacity="0" />
                        <Border x:Name="kart" Width="{Binding Genislik}" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource Kabarik}" BorderBrush="{DynamicResource Cizgi2}" BorderThickness="1" CornerRadius="16"
                                Effect="{DynamicResource Golge.Buyuk}" RenderTransformOrigin="0.5,0.5" Opacity="0">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                            </Border.RenderTransform>
                            <ContentPresenter Content="{Binding}" />
                        </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="perde" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                    <DoubleAnimation Storyboard.TargetName="kart" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetName="kart" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="kart" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{x:Static a:Bildirim.Acik}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="kart" Width="360" Margin="0,10,0,0" Padding="14,12,10,12" CornerRadius="12"
                            Background="{DynamicResource Kabarik}" BorderBrush="{DynamicResource Cizgi2}" BorderThickness="1"
                            Effect="{DynamicResource Golge.Orta}" Opacity="0">
                        <Border.RenderTransform>
                            <TranslateTransform X="40" />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top"
                                    Background="{Binding Renk, Converter={StaticResource KaynakFirca}, ConverterParameter=Yumusak}">
                                <TextBlock Text="{Binding Ikon}" Style="{StaticResource Yazi.Ikon}" FontSize="14"
                                           Foreground="{Binding Renk, Converter={StaticResource KaynakFirca}, ConverterParameter=Metin}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Baslik}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Mesaj}" Style="{StaticResource Yazi.Ikincil}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Mesaj, Converter={StaticResource DoluGorunur}}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource Dugme.Yumusak}" MinHeight="30" Padding="12,0" Content="{Binding EylemMetni}"
                                    Command="{Binding EylemCommand}" VerticalAlignment="Center"
                                    Visibility="{Binding EylemMetni, Converter={StaticResource DoluGorunur}}" />
                            <Button Grid.Column="3" Style="{StaticResource Dugme.Ikon}" Width="28" Height="28" a:Ui.Ikon="&#xE8BB;" FontSize="9"
                                    Margin="4,0,0,0" Command="{Binding KapatCommand}" VerticalAlignment="Top" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="kart" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetName="kart" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.28">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
