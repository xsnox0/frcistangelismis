<UserControl x:Class="Frcistan.Sayfalar.RaporlarSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="clr-namespace:Frcistan.Altyapi"
             xmlns:k="clr-namespace:Frcistan.Kontroller">
    <UserControl.Resources>
        <Style x:Key="OzetKarti" TargetType="Border" BasedOn="{StaticResource Kart}">
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,-14,0">
        <StackPanel Margin="0,0,14,0">
            <Grid Margin="0,0,0,16">
                <TextBlock Text="Satış performansı ve hazır raporlar" Style="{StaticResource Yazi.Ikincil}" VerticalAlignment="Center" />
                <Border Style="{StaticResource SecimGrubu}" Background="{DynamicResource Yuzey}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Secim}" GroupName="rDonem" Content="7 gün" IsChecked="{Binding Donem, Converter={StaticResource EsitMi}, ConverterParameter=7}" />
                        <RadioButton Style="{StaticResource Secim}" GroupName="rDonem" Content="30 gün" IsChecked="{Binding Donem, Converter={StaticResource EsitMi}, ConverterParameter=30}" />
                        <RadioButton Style="{StaticResource Secim}" GroupName="rDonem" Content="90 gün" IsChecked="{Binding Donem, Converter={StaticResource EsitMi}, ConverterParameter=90}" />
                        <RadioButton Style="{StaticResource Secim}" GroupName="rDonem" Content="1 yıl" IsChecked="{Binding Donem, Converter={StaticResource EsitMi}, ConverterParameter=365}" />
                        <RadioButton Style="{StaticResource Secim}" GroupName="rDonem" Content="Tümü" IsChecked="{Binding Donem, Converter={StaticResource EsitMi}, ConverterParameter=Tumu}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,-14,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource OzetKarti}">
                    <StackPanel>
                        <TextBlock Text="Satış tutarı" Style="{StaticResource Yazi.Ikincil}" />
                        <TextBlock Text="{Binding SatisTutari}" Style="{StaticResource Yazi.KPI}" FontSize="23" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource OzetKarti}">
                    <StackPanel>
                        <TextBlock Text="Satılan ürün" Style="{StaticResource Yazi.Ikincil}" />
                        <TextBlock Text="{Binding SatisAdedi}" Style="{StaticResource Yazi.KPI}" FontSize="23" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource OzetKarti}">
                    <StackPanel>
                        <TextBlock Text="Alım (stok girişi)" Style="{StaticResource Yazi.Ikincil}" />
                        <TextBlock Text="{Binding AlimTutari}" Style="{StaticResource Yazi.KPI}" FontSize="23" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource OzetKarti}">
                    <StackPanel>
                        <TextBlock Text="Brüt kâr (tahmini)" Style="{StaticResource Yazi.Ikincil}" />
                        <TextBlock Text="{Binding BrutKar}" Style="{StaticResource Yazi.KPI}" FontSize="23" Margin="0,6,0,0" Foreground="{DynamicResource BasariMetin}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="330" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Kart}">
                    <StackPanel>
                        <TextBlock Text="En çok satan ürünler" Style="{StaticResource Yazi.H3}" />
                        <TextBlock Text="Satış tutarına göre" Style="{StaticResource Yazi.Kucuk}" Margin="0,2,0,12" />
                        <ItemsControl ItemsSource="{Binding EnCokSatanlar}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Ad}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding AltMetin}" Style="{StaticResource Yazi.Kucuk}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" x:Name="ray" Height="10" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource Yuzey3}" CornerRadius="5" />
                                            <Border Background="{Binding Renk, Converter={StaticResource HexFirca}}" CornerRadius="5" HorizontalAlignment="Left">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource OranGenislik}">
                                                        <Binding Path="Oran" />
                                                        <Binding Path="ActualWidth" ElementName="ray" />
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding DegerMetni}" FontWeight="SemiBold" Margin="16,0,0,0" MinWidth="90" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Style="{StaticResource BosDurum}" Visibility="{Binding SatisYok, Converter={StaticResource Gorunur}}">
                            <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource IkonYazi}" FontSize="22" Foreground="{DynamicResource Metin3}" HorizontalAlignment="Center" />
                            <TextBlock Text="Bu dönemde satış yok" Style="{StaticResource Yazi.Ikincil}" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Kart}">
                    <StackPanel>
                        <TextBlock Text="Kategoriye göre satış" Style="{StaticResource Yazi.H3}" />
                        <TextBlock Text="Dilimlerin üzerine gelerek ayrıntı görün" Style="{StaticResource Yazi.Kucuk}" Margin="0,2,0,8" />
                        <k:HalkaGrafik Width="230" Height="230" Dilimler="{Binding KategoriSatislari}" MerkezBaslik="Toplam satış" MerkezDeger="{Binding KategoriToplam}" Kalinlik="22" />
                        <ItemsControl ItemsSource="{Binding KategoriSatislari}" Margin="0,12,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="6,3">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Renk, Converter={StaticResource HexFirca}}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Ad}" Style="{StaticResource Yazi.Kucuk}" Foreground="{DynamicResource Metin2}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Hazır raporlar" Style="{StaticResource Yazi.H2}" Margin="0,0,0,4" />
            <TextBlock Text="Excel'e aktarın ya da yazdırın. PDF için yazıcı olarak “Microsoft Print to PDF” seçin." Style="{StaticResource Yazi.Ikincil}" Margin="0,0,0,14" />
            <ItemsControl ItemsSource="{Binding Kartlar}" Focusable="False" Margin="0,0,-14,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Kart}" Margin="0,0,14,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IkonKutusu}" Background="{Binding Renk, Converter={StaticResource HexFirca}, ConverterParameter=Yumusak}">
                                        <TextBlock Text="{Binding Ikon}" Style="{StaticResource Yazi.Ikon}" Foreground="{Binding Renk, Converter={StaticResource HexFirca}}" />
                                    </Border>
                                    <TextBlock Text="{Binding Baslik}" Style="{StaticResource Yazi.H3}" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Aciklama}" Style="{StaticResource Yazi.Ikincil}" Margin="0,14,0,16" MinHeight="36" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource Dugme.Yumusak}" a:Ui.Ikon="&#xE896;" Content="Excel" Command="{Binding ExcelCommand}" MinHeight="34" Margin="0,0,8,0" />
                                    <Button a:Ui.Ikon="&#xE749;" Content="Yazdır / PDF" Command="{Binding YazdirCommand}" MinHeight="34"
                                            Visibility="{Binding YazdirCommand, Converter={StaticResource DoluGorunur}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
