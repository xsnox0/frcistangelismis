<UserControl x:Class="Frcistan.Sayfalar.AyarlarSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="clr-namespace:Frcistan.Altyapi">
    <UserControl.Resources>
        <!-- Sol bölüm menüsü -->
        <Style x:Key="BolumDugmesi" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Metin2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OdakYok}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="kok" Background="Transparent" CornerRadius="9" Padding="12,10" Margin="0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding (a:Ui.Ikon), RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IkonYazi}"
                                           FontSize="14" Width="26" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontWeight="SemiBold" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="kok" Property="Background" Value="{DynamicResource Yuzey3}" />
                                <Setter Property="Foreground" Value="{DynamicResource Metin}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="kok" Property="Background" Value="{DynamicResource VurguYumusak}" />
                                <Setter Property="Foreground" Value="{DynamicResource VurguMetin}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Bolum" TargetType="StackPanel">
            <Setter Property="MaxWidth" Value="760" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="AyarSatiri" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Cizgi}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,16" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Bölümler -->
        <Border Style="{StaticResource Kart}" Padding="8" VerticalAlignment="Top">
            <StackPanel>
                <RadioButton Style="{StaticResource BolumDugmesi}" GroupName="bolum" a:Ui.Ikon="&#xE731;" Content="Firma" IsChecked="{Binding Bolum, Converter={StaticResource EsitMi}, ConverterParameter=Genel}" />
                <RadioButton Style="{StaticResource BolumDugmesi}" GroupName="bolum" a:Ui.Ikon="&#xF354;" Content="Görünüm" IsChecked="{Binding Bolum, Converter={StaticResource EsitMi}, ConverterParameter=Gorunum}" />
                <RadioButton Style="{StaticResource BolumDugmesi}" GroupName="bolum" a:Ui.Ikon="&#xE77B;" Content="Hesabım" IsChecked="{Binding Bolum, Converter={StaticResource EsitMi}, ConverterParameter=Hesap}" />
                <RadioButton Style="{StaticResource BolumDugmesi}" GroupName="bolum" a:Ui.Ikon="&#xEE94;" Content="Veritabanı" IsChecked="{Binding Bolum, Converter={StaticResource EsitMi}, ConverterParameter=Veritabani}" />
                <RadioButton Style="{StaticResource BolumDugmesi}" GroupName="bolum" a:Ui.Ikon="&#xE895;" Content="Yedekleme" IsChecked="{Binding Bolum, Converter={StaticResource EsitMi}, ConverterParameter=Yedek}" />
                <RadioButton Style="{StaticResource BolumDugmesi}" GroupName="bolum" a:Ui.Ikon="&#xEA18;" Content="Lisans" IsChecked="{Binding Bolum, Converter={StaticResource EsitMi}, ConverterParameter=Lisans}" />
                <RadioButton Style="{StaticResource BolumDugmesi}" GroupName="bolum" a:Ui.Ikon="&#xE946;" Content="Hakkında" IsChecked="{Binding Bolum, Converter={StaticResource EsitMi}, ConverterParameter=Hakkinda}" />
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Kart}" Padding="30,26">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid>
                    <!-- FİRMA -->
                    <StackPanel Style="{StaticResource Bolum}" Visibility="{Binding Bolum, Converter={StaticResource EsitGorunur}, ConverterParameter=Genel}">
                        <TextBlock Text="Firma bilgileri" Style="{StaticResource Yazi.H2}" />
                        <TextBlock Text="Bu ayarlar veritabanında saklanır; aynı veritabanını kullanan tüm bilgisayarlarda geçerlidir." Style="{StaticResource Yazi.Ikincil}" Margin="0,4,0,24" />
                        <StackPanel IsEnabled="{Binding Admin}">
                            <TextBlock Text="Firma adı" Style="{StaticResource Yazi.Etiket}" />
                            <TextBox Text="{Binding FirmaAdi, UpdateSourceTrigger=PropertyChanged}" a:Ui.Ikon="&#xE731;" a:Ui.Ipucu="Raporların başında görünür" MaxLength="80" />

                            <TextBlock Text="Para birimi" Style="{StaticResource Yazi.Etiket}" Margin="0,20,0,8" />
                            <Border Style="{StaticResource SecimGrubu}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Secim}" GroupName="ayarPara" Content="$  Dolar" MinHeight="32" Padding="16,0" IsChecked="{Binding ParaBirimi, Converter={StaticResource EsitMi}, ConverterParameter=USD}" />
                                    <RadioButton Style="{StaticResource Secim}" GroupName="ayarPara" Content="₺  Türk lirası" MinHeight="32" Padding="16,0" IsChecked="{Binding ParaBirimi, Converter={StaticResource EsitMi}, ConverterParameter=TRY}" />
                                    <RadioButton Style="{StaticResource Secim}" GroupName="ayarPara" Content="€  Euro" MinHeight="32" Padding="16,0" IsChecked="{Binding ParaBirimi, Converter={StaticResource EsitMi}, ConverterParameter=EUR}" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Varsayılan kritik stok seviyesi" Style="{StaticResource Yazi.Etiket}" />
                                    <TextBox Text="{Binding MinStok, UpdateSourceTrigger=PropertyChanged}" a:Ui.Sayi="Tam" MaxLength="5" />
                                    <TextBlock Text="Yeni ürünlerde önerilen değer" Style="{StaticResource Yazi.Kucuk}" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ürün kodu ön eki" Style="{StaticResource Yazi.Etiket}" />
                                    <TextBox Text="{Binding KodOnEki, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" CharacterCasing="Upper" />
                                    <TextBlock Text="Otomatik kodlar: FRC-0001, FRC-0002…" Style="{StaticResource Yazi.Kucuk}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                            <Button Style="{StaticResource Dugme.Birincil}" a:Ui.Ikon="&#xE74E;" Content="Kaydet" Command="{Binding FirmaKaydetCommand}" HorizontalAlignment="Left" Margin="0,26,0,0" Padding="20,0" />
                        </StackPanel>
                        <TextBlock Text="Bu ayarları yalnızca yöneticiler değiştirebilir." Style="{StaticResource Yazi.Kucuk}" Margin="0,14,0,0"
                                   Visibility="{Binding Admin, Converter={StaticResource Gorunur}, ConverterParameter=Ters}" />
                    </StackPanel>

                    <!-- GÖRÜNÜM -->
                    <StackPanel Style="{StaticResource Bolum}" Visibility="{Binding Bolum, Converter={StaticResource EsitGorunur}, ConverterParameter=Gorunum}">
                        <TextBlock Text="Görünüm" Style="{StaticResource Yazi.H2}" />
                        <TextBlock Text="Bu ayarlar yalnızca bu bilgisayar için geçerlidir." Style="{StaticResource Yazi.Ikincil}" Margin="0,4,0,12" />
                        <Border Style="{StaticResource AyarSatiri}">
                            <CheckBox Style="{StaticResource Anahtar}" IsChecked="{Binding KoyuTema}">
                                <StackPanel>
                                    <TextBlock Text="Koyu tema" Style="{StaticResource Yazi.H3}" FontSize="14" />
                                    <TextBlock Text="Gece ve loş ortamlarda göz yormaz. Kapatırsanız açık tema kullanılır." Style="{StaticResource Yazi.Ikincil}" Margin="0,3,0,0" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource AyarSatiri}">
                            <CheckBox Style="{StaticResource Anahtar}" IsChecked="{Binding PencereTamEkran}">
                                <StackPanel>
                                    <TextBlock Text="Tam ekran başlat" Style="{StaticResource Yazi.H3}" FontSize="14" />
                                    <TextBlock Text="Program açılınca pencere ekranı kaplasın." Style="{StaticResource Yazi.Ikincil}" Margin="0,3,0,0" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <TextBlock Text="Klavye kısayolları" Style="{StaticResource Yazi.H3}" Margin="0,24,0,10" />
                        <Border Background="{DynamicResource Yuzey2}" CornerRadius="10" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="0,4" />
                                        <Setter Property="Foreground" Value="{DynamicResource Metin2}" />
                                    </Style>
                                </Grid.Resources>
                                <TextBlock Text="Ctrl + K" FontWeight="SemiBold" Foreground="{DynamicResource Metin}" /><TextBlock Grid.Column="1" Text="Ürün ara" />
                                <TextBlock Grid.Row="1" Text="Ctrl + S" FontWeight="SemiBold" Foreground="{DynamicResource Metin}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="Hızlı satış / stok çıkışı" />
                                <TextBlock Grid.Row="2" Text="Ctrl + N" FontWeight="SemiBold" Foreground="{DynamicResource Metin}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="Yeni ürün (Ürünler sayfasında)" />
                                <TextBlock Grid.Row="3" Text="Ctrl + 1 … 7" FontWeight="SemiBold" Foreground="{DynamicResource Metin}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="Menüdeki sayfalar arasında geçiş" />
                                <TextBlock Grid.Row="4" Text="F5" FontWeight="SemiBold" Foreground="{DynamicResource Metin}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="Sayfayı yenile" />
                                <TextBlock Grid.Row="5" Text="Esc" FontWeight="SemiBold" Foreground="{DynamicResource Metin}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="Açık pencereyi kapat" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- HESABIM -->
                    <StackPanel Style="{StaticResource Bolum}" Visibility="{Binding Bolum, Converter={StaticResource EsitGorunur}, ConverterParameter=Hesap}">
                        <TextBlock Text="Hesabım" Style="{StaticResource Yazi.H2}" />
                        <Border Background="{DynamicResource Yuzey2}" CornerRadius="12" Padding="18" Margin="0,20,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="54" Height="54" CornerRadius="27">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3D7EFF" Offset="0" />
                                            <GradientStop Color="#8B5CF6" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding GorunenAd, Converter={StaticResource BasHarf}}" FontFamily="Segoe UI" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GorunenAd}" Style="{StaticResource Yazi.H3}" />
                                    <TextBlock Style="{StaticResource Yazi.Kucuk}" Margin="0,3,0,0"><Run Text="@" /><Run Text="{Binding KullaniciAdi, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding RolMetni, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2" a:Ui.Ikon="&#xE72E;" Content="Şifre değiştir" Command="{Binding SifreCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- VERİTABANI -->
                    <StackPanel Style="{StaticResource Bolum}" Visibility="{Binding Bolum, Converter={StaticResource EsitGorunur}, ConverterParameter=Veritabani}">
                        <TextBlock Text="Veritabanı" Style="{StaticResource Yazi.H2}" />
                        <TextBlock Text="Verilerinizin saklandığı yer. Birden fazla bilgisayardan kullanmak için MySQL/MariaDB sunucusuna geçebilirsiniz." Style="{StaticResource Yazi.Ikincil}" Margin="0,4,0,20" />
                        <Border Background="{DynamicResource Yuzey2}" CornerRadius="12" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IkonKutusu}" VerticalAlignment="Top">
                                    <TextBlock Text="&#xEE94;" Style="{StaticResource Yazi.Ikon}" Foreground="{DynamicResource VurguMetin}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding VeritabaniAciklama}" Style="{StaticResource Yazi.H3}" />
                                    <TextBox Text="{Binding VeritabaniYolu, Mode=OneWay}" IsReadOnly="True" Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12" MinHeight="34" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource Dugme.Birincil}" a:Ui.Ikon="&#xE713;" Content="Bağlantıyı değiştir" Command="{Binding VeritabaniCommand}" Margin="0,0,10,0"
                                    Visibility="{Binding Admin, Converter={StaticResource Gorunur}}" />
                            <Button a:Ui.Ikon="&#xE8B7;" Content="Veri klasörünü aç" Command="{Binding KlasorAcCommand}" CommandParameter="{Binding VeriKlasoru}"
                                    Visibility="{Binding Sqlite, Converter={StaticResource Gorunur}}" />
                        </StackPanel>

                        <TextBlock Text="Frcistan 0.1'den geçiş" Style="{StaticResource Yazi.H3}" Margin="0,32,0,4" />
                        <TextBlock Text="Eski sürümün (XAMPP / MySQL frcistan01) ürün, kategori ve kullanıcılarını bu veritabanına aktarın. Aynı ürünler birleştirilir, şifreler güvenli biçimde yeniden şifrelenir."
                                   Style="{StaticResource Yazi.Ikincil}" />
                        <Button a:Ui.Ikon="&#xE898;" Content="0.1 verilerini aktar" Command="{Binding AktarimCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Visibility="{Binding Admin, Converter={StaticResource Gorunur}}" />
                    </StackPanel>

                    <!-- YEDEKLEME -->
                    <StackPanel Style="{StaticResource Bolum}" Visibility="{Binding Bolum, Converter={StaticResource EsitGorunur}, ConverterParameter=Yedek}">
                        <TextBlock Text="Yedekleme" Style="{StaticResource Yazi.H2}" />
                        <TextBlock Text="Yedekler tüm ürünleri, kategorileri, kullanıcıları ve stok hareketlerini içerir. Bir bilgisayarın yedeği başka bir bilgisayara ya da MySQL sunucusuna yüklenebilir."
                                   Style="{StaticResource Yazi.Ikincil}" Margin="0,4,0,12" />
                        <Border Style="{StaticResource AyarSatiri}">
                            <CheckBox Style="{StaticResource Anahtar}" IsChecked="{Binding OtomatikYedek}">
                                <StackPanel>
                                    <TextBlock Text="Günlük otomatik yedek" Style="{StaticResource Yazi.H3}" FontSize="14" />
                                    <TextBlock Text="Program her gün ilk açıldığında yedek alır; son 14 yedek saklanır." Style="{StaticResource Yazi.Ikincil}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding SonYedek}" Style="{StaticResource Yazi.Kucuk}" Margin="0,6,0,0" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <WrapPanel Margin="0,20,0,0">
                            <Button Style="{StaticResource Dugme.Birincil}" a:Ui.Ikon="&#xE74E;" Content="Şimdi yedek al" Command="{Binding YedekAlCommand}" Margin="0,0,10,10" />
                            <Button a:Ui.Ikon="&#xE81C;" Content="Yedekten geri yükle" Command="{Binding GeriYukleCommand}" Margin="0,0,10,10"
                                    Visibility="{Binding Admin, Converter={StaticResource Gorunur}}" />
                            <Button a:Ui.Ikon="&#xE8B7;" Content="Otomatik yedek klasörü" Command="{Binding KlasorAcCommand}" CommandParameter="{Binding YedekKlasoru}" Margin="0,0,10,10" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- LİSANS -->
                    <StackPanel Style="{StaticResource Bolum}" Visibility="{Binding Bolum, Converter={StaticResource EsitGorunur}, ConverterParameter=Lisans}">
                        <TextBlock Text="Lisans" Style="{StaticResource Yazi.H2}" />
                        <Border CornerRadius="14" Padding="22" Margin="0,20,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1F3D7EFF" Offset="0" />
                                    <GradientStop Color="#148B5CF6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Vurgu}">
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource Yazi.Ikon}" FontSize="22" Foreground="White" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Lisans.Baslik}" Style="{StaticResource Yazi.H2}" FontSize="17" />
                                    <TextBlock Text="{Binding Lisans.Aciklama}" Style="{StaticResource Yazi.Ikincil}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource Dugme.Birincil}" Content="Lisans anahtarı gir" Command="{Binding LisansCommand}" VerticalAlignment="Center"
                                        Visibility="{Binding Lisansli, Converter={StaticResource Gorunur}, ConverterParameter=Ters}" />
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Yazi.Ikincil}" Margin="0,16,0,0"
                                   Text="Deneme süresince tüm özellikler açıktır. Süre bittiğinde kayıtlarınız korunur ve görüntülenebilir; ekleme ve değişiklik için lisans gerekir. Lisans, aynı veritabanını kullanan tüm bilgisayarlarda geçerlidir." />
                    </StackPanel>

                    <!-- HAKKINDA -->
                    <StackPanel Style="{StaticResource Bolum}" Visibility="{Binding Bolum, Converter={StaticResource EsitGorunur}, ConverterParameter=Hakkinda}">
                        <Border Width="84" Height="84" CornerRadius="22" HorizontalAlignment="Left" Background="#0B1020">
                            <Image Source="/Assets/logo-beyaz.png" Margin="14" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="Frcistan" Style="{StaticResource Yazi.H1}" FontSize="28" Margin="0,18,0,2" />
                        <TextBlock Style="{StaticResource Yazi.Ikincil}"><Run Text="Robot parçası stok yönetimi · Sürüm" /> <Run Text="{Binding Surum, Mode=OneWay}" /></TextBlock>
                        <Border Background="{DynamicResource Yuzey2}" CornerRadius="12" Padding="18,14" Margin="0,22,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Geliştiren" Style="{StaticResource Yazi.Kucuk}" Margin="0,4" />
                                <TextBlock Grid.Column="1" Text="{Binding Gelistirici}" FontWeight="SemiBold" Margin="0,4" />
                                <TextBlock Grid.Row="1" Text="Altyapı" Style="{StaticResource Yazi.Kucuk}" Margin="0,4" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text=".NET 10 · WPF · Entity Framework Core · SQLite / MySQL" Margin="0,4" />
                                <TextBlock Grid.Row="2" Text="Ayar klasörü" Style="{StaticResource Yazi.Kucuk}" Margin="0,4" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AyarKlasoru}" Margin="0,4" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Metin2}" />
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button a:Ui.Ikon="&#xE8B7;" Content="Ayar klasörünü aç" Command="{Binding KlasorAcCommand}" Margin="0,0,10,0" />
                            <Button a:Ui.Ikon="&#xE8A5;" Content="Hata günlüğü" Command="{Binding GunlukAcCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
