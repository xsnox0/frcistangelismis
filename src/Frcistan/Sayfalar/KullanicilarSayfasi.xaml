<UserControl x:Class="Frcistan.Sayfalar.KullanicilarSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="clr-namespace:Frcistan.Altyapi">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Rozet}" Background="{DynamicResource VurguYumusak}" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource Rozet.Yazi}" Foreground="{DynamicResource VurguMetin}" Text="Yönetici: ürün, kullanıcı ve ayarları yönetir" />
                </Border>
                <Border Style="{StaticResource Rozet}" Background="{DynamicResource BasariYumusak}">
                    <TextBlock Style="{StaticResource Rozet.Yazi}" Foreground="{DynamicResource BasariMetin}" Text="Personel: ürünleri görür, stok giriş/çıkışı yapar" />
                </Border>
            </StackPanel>
            <Button Style="{StaticResource Dugme.Birincil}" a:Ui.Ikon="&#xE8FA;" Content="Yeni kullanıcı" Command="{Binding YeniCommand}" HorizontalAlignment="Right" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,-14,0">
            <ItemsControl ItemsSource="{Binding Kullanicilar}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid VerticalAlignment="Top" Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource SutunSayisi}, ConverterParameter=320}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="kart" Style="{StaticResource Kart}" Margin="0,0,16,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="24" Background="{Binding Renk, Converter={StaticResource HexFirca}, ConverterParameter=Yumusak}">
                                        <TextBlock Text="{Binding GorunenAd, Converter={StaticResource BasHarf}}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="15"
                                                   Foreground="{Binding Renk, Converter={StaticResource HexFirca}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding GorunenAd}" Style="{StaticResource Yazi.H3}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                            <Border Style="{StaticResource Rozet}" Background="{DynamicResource Yuzey3}" Margin="8,0,0,0" Padding="7,1,7,2"
                                                    Visibility="{Binding Ben, Converter={StaticResource Gorunur}}">
                                                <TextBlock Text="Siz" Style="{StaticResource Rozet.Yazi}" FontSize="11" Foreground="{DynamicResource Metin2}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Yazi.Kucuk}" Margin="0,2,0,0"><Run Text="@" /><Run Text="{Binding KullaniciAdi, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource Dugme.Ikon}" a:Ui.Ikon="&#xE70F;" ToolTip="Düzenle"
                                                Command="{Binding DataContext.DuzenleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Dugme.IkonTehlike}" a:Ui.Ikon="&#xE74D;" ToolTip="Sil"
                                                Visibility="{Binding Ben, Converter={StaticResource Gorunur}, ConverterParameter=Ters}"
                                                Command="{Binding DataContext.SilCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource Ayirac}" Margin="0,18,0,14" />
                                <Grid>
                                    <Border HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Rozet}">
                                                <Setter Property="Background" Value="{DynamicResource BasariYumusak}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource BasariMetin}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Yonetici}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource VurguYumusak}" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource VurguMetin}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RolMetni}" Style="{StaticResource Rozet.Yazi}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Margin="0,1,7,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Basari}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Aktif}" Value="False">
                                                            <Setter Property="Fill" Value="{DynamicResource Metin3}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Yazi.Kucuk}">
                                                    <Setter Property="Text" Value="{Binding SonGirisMetni}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Aktif}" Value="False">
                                                            <Setter Property="Text" Value="Devre dışı" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Aktif}" Value="False">
                                <Setter TargetName="kart" Property="Opacity" Value="0.6" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
